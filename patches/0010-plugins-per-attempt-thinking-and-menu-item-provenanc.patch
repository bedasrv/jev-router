+test("0010: the in-band provenance frame carries the menu item and the answering attempt's thinking", async () => {
+  const delayed = new Promise<Response>((resolve) => setTimeout(() => resolve(routed({
+    "x-omniroute-route": "ocpaid/opencode-go/muse-spark-1.3-contributor", "x-omniroute-attempts": "1",
+    "x-router-reason": "jev", "x-router-confidence": "0.91", "x-router-item": "P3", "x-router-thinking": "high",
+  })), 60));
+  const result = await withEarlyStreamKeepalive(delayed, { thresholdMs: 10, intervalMs: 1000, provenanceFrame: openAiRouteProvenanceFrame });
+  const text = await drainStream(result.body!);
+  const meta = text.split("\n\n").filter((f) => f.startsWith("data: {")).map((f) => JSON.parse(f.slice(6))).find((c) => c.x_omniroute);
+  assert.deepEqual(meta?.x_omniroute, { route: "ocpaid/opencode-go/muse-spark-1.3-contributor", attempts: "1", reason: "jev", confidence: "0.91", item: "P3", thinking: "high" });
+});
