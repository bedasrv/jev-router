 export const MAX_PLUGIN_ROUTE_MODELS = 12;
@@ -60,6 +66,42 @@ function normalizePluginThinking(value: unknown): PluginThinking | null {
   return { control, value: text };
 }
 
+const ITEM_ID = /^[A-Za-z0-9_-]{1,16}$/;
+
+/** A menu item id, or null: never echoed unless it is a short plain token. */
+function normalizeRouteItem(value: unknown): string | null {
+  return typeof value === "string" && ITEM_ID.test(value) ? value : null;
+}
+
+/**
+ * Per-attempt thinking: only targets that are in the final model list, each through the same allowlist
+ * as `thinking`. A malformed entry is dropped (that attempt then gets {control:"none"}). Null when the
+ * plugin sent no usable map, so the single-`thinking` behaviour of 0008 stays.
+ */
+function normalizeThinkingByModel(value: unknown, models: string[]): Record<string, PluginThinking> | null {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return null;
+  const out: Record<string, PluginThinking> = {};
+  for (const model of models) {
+    if (!Object.prototype.hasOwnProperty.call(value, model)) continue;
+    const t = normalizePluginThinking((value as Record<string, unknown>)[model]);
+    if (t) out[model] = t;
+  }
+  return Object.keys(out).length ? out : null;
+}
+
+/**
+ * The thinking one attempt of a plugin-routed combo carries: its own entry when the plugin sent a
+ * per-attempt map, {control:"none"} for a target the map leaves out, or the shared selection (0008).
+ */
+export function pluginAttemptThinking(
+  combo: PluginRouteComboLike | null | undefined,
+  model: string
+): PluginThinking | undefined {
+  if (!combo) return undefined;
+  if (combo.routeThinkingByModel) return combo.routeThinkingByModel[model] ?? { control: "none" };
+  return combo.routeThinking;
+}
+
 export async function runPluginOnRouteHook(args: {
   requestId: string;
   body: unknown;
@@ -99,11 +141,15 @@ export async function runPluginOnRouteHook(args: {
       `onRoute: ${args.model} → [${models.join(", ")}]${result.reason ? ` (${result.reason})` : ""}`
     );
     const thinking = normalizePluginThinking(result.thinking);
+    const thinkingByModel = normalizeThinkingByModel(result.thinking_by_model, models);
+    const item = normalizeRouteItem(result.item);
     return {
       models,
       ...(typeof result.reason === "string" ? { reason: result.reason } : {}),
       ...(typeof result.confidence === "number" ? { confidence: result.confidence } : {}),
       ...(thinking ? { thinking } : {}),
+      ...(thinkingByModel ? { thinkingByModel } : {}),
+      ...(item ? { item } : {}),
     };
   } catch (err) {
     args.log?.debug?.(
@@ -140,6 +186,8 @@ export function buildPluginRouteCombo(
     routeReason: typeof metadata.reason === "string" ? metadata.reason : undefined,
     routeConfidence: typeof metadata.confidence === "number" ? metadata.confidence : undefined,
     routeThinking: normalizePluginThinking(metadata.thinking) ?? undefined,
+    routeThinkingByModel: normalizeThinkingByModel(metadata.thinkingByModel, models) ?? undefined,
+    routeItem: normalizeRouteItem(metadata.item) ?? undefined,
     isHidden: true,
     isActive: true,
     sortOrder: 0,
@@ -233,6 +281,13 @@ export function buildPluginRouteHeaders(
     const confidence = reason === "jev" ? normalizeRouteConfidence(combo.routeConfidence) : null;
     if (confidence) headers["x-router-confidence"] = confidence;
   }
+  // Patch 0010: the plugin's menu item, and the thinking the ANSWERING attempt carried ("default" = no field).
+  const item = normalizeRouteItem(combo.routeItem);
+  if (item) headers["x-router-item"] = item;
+  if (combo.routeThinkingByModel || combo.routeThinking) {
+    const t = pluginAttemptThinking(combo, target);
+    headers["x-router-thinking"] = t && t.control !== "none" && t.value ? t.value : "default";
+  }
   return headers;
 }
 
