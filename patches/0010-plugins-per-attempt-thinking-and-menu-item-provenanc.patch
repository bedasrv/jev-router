+
+// ── patch 0010: per-attempt thinking and menu item provenance ──
+
+test("0010: runPluginOnRouteHook keeps a per-attempt thinking map for listed targets only, and a plain item id", async () => {
+  registerHook("onRoute", "p", () => ({
+    models: ["a/x", "b/y"], reason: "jev", confidence: 0.9, item: "P3",
+    thinking: { control: "none" },
+    thinking_by_model: { "a/x": { control: "effort", value: "high" }, "b/y": { control: "none" }, "z/not-listed": { control: "effort", value: "max" }, },
+  }), 1);
+  const out = await runPluginOnRouteHook({ requestId: "r20", body: {}, model: "paid", apiKeyInfo: null });
+  assert.deepEqual(out?.thinkingByModel, { "a/x": { control: "effort", value: "high" }, "b/y": { control: "none" } });
+  assert.equal(out?.item, "P3");
+});
+
+test("0010: malformed per-attempt entries and item ids are dropped, never echoed", async () => {
+  registerHook("onRoute", "p", () => ({
+    models: ["a/x", "b/y"], item: "P3\r\nx-evil: 1",
+    thinking_by_model: { "a/x": { control: "toggle", value: "high" }, "b/y": { control: "effort", value: "x".repeat(40) } },
+  }), 1);
+  const out = await runPluginOnRouteHook({ requestId: "r21", body: {}, model: "paid", apiKeyInfo: null });
+  assert.equal(out?.thinkingByModel, undefined);
+  assert.equal(out?.item, undefined);
+});
+
+test("0010: each attempt gets its own model's value; a target the map leaves out is sent with none; no map = 0008", () => {
+  const combo = buildPluginRouteCombo("paid", ["a/x", "b/y", "c/z"], "r22", {
+    thinking: { control: "effort", value: "low" },
+    thinkingByModel: { "a/x": { control: "effort", value: "low" }, "b/y": { control: "toggle", value: "on" } },
+  });
+  assert.deepEqual(pluginAttemptThinking(combo, "a/x"), { control: "effort", value: "low" });
+  assert.deepEqual(pluginAttemptThinking(combo, "b/y"), { control: "toggle", value: "on" });
+  assert.deepEqual(pluginAttemptThinking(combo, "c/z"), { control: "none" });
+  const client = { model: "paid", reasoning_effort: "high", messages: [] };
+  assert.deepEqual(applyPluginRouteThinking(client, pluginAttemptThinking(combo, "a/x")), { model: "paid", reasoning_effort: "low", messages: [] });
+  assert.deepEqual(applyPluginRouteThinking(client, pluginAttemptThinking(combo, "b/y")), { model: "paid", messages: [], thinking: { type: "enabled" } });
+  assert.deepEqual(applyPluginRouteThinking(client, pluginAttemptThinking(combo, "c/z")), { model: "paid", messages: [] });
+  assert.equal(client.reasoning_effort, "high", "the shared body is never mutated");
+  const old = buildPluginRouteCombo("paid", ["a/x", "b/y"], "r23", { thinking: { control: "effort", value: "high" } });
+  assert.equal(old.routeThinkingByModel, undefined);
+  assert.deepEqual(pluginAttemptThinking(old, "b/y"), { control: "effort", value: "high" });
+});
+
+test("0010: headers name the item and the thinking of the attempt that answered", () => {
+  const combo = buildPluginRouteCombo("paid", ["a/x", "b/y"], "r24", {
+    reason: "jev", confidence: 0.9, item: "P3",
+    thinkingByModel: { "a/x": { control: "effort", value: "high" }, "b/y": { control: "none" } },
+  });
+  const id = String(combo.traceInvocationId);
+  startComboTrace(id, { strategy: "priority", comboName: "paid" });
+  recordComboOutcome(id, { target: "a/x", ok: false, status: 503, kind: "provider", latencyMs: 50 });
+  recordComboOutcome(id, { target: "b/y", ok: true, status: 200, kind: null, latencyMs: 700 });
+  assert.deepEqual(buildPluginRouteHeaders(combo), {
+    "x-omniroute-route": "b/y",
+    "x-omniroute-attempts": "2",
+    "x-router-reason": "jev",
+    "x-router-confidence": "0.9",
+    "x-router-item": "P3",
+    "x-router-thinking": "default",
+  });
+  const head = buildPluginRouteCombo("paid", ["a/x"], "r25", { reason: "static", item: "P4", thinkingByModel: { "a/x": { control: "effort", value: "max" } } });
+  const hid = String(head.traceInvocationId);
+  startComboTrace(hid, { strategy: "priority", comboName: "paid" });
+  recordComboOutcome(hid, { target: "a/x", ok: true, status: 200, kind: null, latencyMs: 100 });
+  assert.equal(buildPluginRouteHeaders(head)["x-router-thinking"], "max");
+  assert.equal(buildPluginRouteHeaders(head)["x-router-item"], "P4");
+});
+
+test("0010: a plugin that sends neither item nor thinking gets the 0007 headers unchanged", () => {
+  const combo = buildPluginRouteCombo("paid", ["a/x"], "r26", { reason: "static" });
+  const id = String(combo.traceInvocationId);
+  startComboTrace(id, { strategy: "priority", comboName: "paid" });
+  recordComboOutcome(id, { target: "a/x", ok: true, status: 200, kind: null, latencyMs: 100 });
+  assert.deepEqual(buildPluginRouteHeaders(combo), { "x-omniroute-route": "a/x", "x-omniroute-attempts": "1", "x-router-reason": "static" });
+});
