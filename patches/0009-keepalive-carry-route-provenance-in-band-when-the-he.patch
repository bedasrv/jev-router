From 5a4f711328e905210b38342d5d03b52ce92a3e4f Mon Sep 17 00:00:00 2001
From: jev-router-ci <jev-router-ci@users.noreply.github.com>
Date: Sat, 31 Oct 2026 18:35:38 +0700
Subject: [PATCH] keepalive: carry route provenance in-band when the head is
 committed early

withEarlyStreamKeepalive commits a 200 head when the handler is slower than its threshold (1 s on chat), then forwards only the handler's body, so the route provenance headers patch 0007 stamps (x-omniroute-route, x-omniroute-attempts, x-router-reason, x-router-confidence) were lost on every slow call (about 86% of production calls on 2026-10-31). A new provenanceFrame option is called with the handler's SSE headers on the slow path; /v1/chat/completions passes openAiRouteProvenanceFrame, which writes one choices-less chunk (id/model keepalive) with an x_omniroute object of the allowlisted fields just before the forwarded body. The fast path is unchanged (headers verbatim, body untouched).
---
 open-sse/utils/earlyStreamKeepalive.ts   | 46 ++++++++++++++++++++++
 src/app/api/v1/chat/completions/route.ts |  2 +
 tests/unit/earlyStreamKeepalive.test.ts  | 50 +++++++++++++++++++++++-
 3 files changed, 97 insertions(+), 1 deletion(-)

diff --git a/open-sse/utils/earlyStreamKeepalive.ts b/open-sse/utils/earlyStreamKeepalive.ts
index 893b752c..5f67e2e1 100644
--- a/open-sse/utils/earlyStreamKeepalive.ts
+++ b/open-sse/utils/earlyStreamKeepalive.ts
@@ -102,6 +102,35 @@ export const OPENAI_RESPONSES_ERROR_FRAME = ENCODER.encode(
   })}\n\n`
 );
 
+/**
+ * Route provenance headers a plugin-routed combo stamps on its response (patch 0007), and the key each
+ * one takes in the in-band frame. On the slow path the 200 head is committed before the handler
+ * resolves, so these headers would be lost; the frame below carries them in the stream instead.
+ */
+const ROUTE_PROVENANCE_FIELDS: ReadonlyArray<[header: string, key: string]> = [
+  ["x-omniroute-route", "route"],
+  ["x-omniroute-attempts", "attempts"],
+  ["x-router-reason", "reason"],
+  ["x-router-confidence", "confidence"],
+];
+
+/**
+ * One OpenAI-compatible chunk with no choices and an `x_omniroute` object holding the route
+ * provenance headers of the handler's response, or null when it has none. Brand-neutral id/model
+ * (`keepalive`, like the startup frame), so clients that read only `choices` see nothing.
+ */
+export function openAiRouteProvenanceFrame(headers: Headers): Uint8Array | null {
+  const fields: Record<string, string> = {};
+  for (const [header, key] of ROUTE_PROVENANCE_FIELDS) {
+    const value = headers.get(header);
+    if (value) fields[key] = value;
+  }
+  if (!fields.route) return null;
+  return ENCODER.encode(
+    `data: ${JSON.stringify({ id: "chatcmpl-keepalive", object: "chat.completion.chunk", created: 0, model: "keepalive", choices: [], x_omniroute: fields })}\n\n`
+  );
+}
+
 const MAX_RETRY_AFTER_SECONDS = 3600;
 
 /**
@@ -220,6 +249,12 @@ export type EarlyStreamKeepaliveOptions = {
   applicationKeepalive?: { frame: Uint8Array; intervalMs: number };
   /** Extra headers to include in the keepalive response (e.g. X-Correlation-Id). */
   extraHeaders?: Record<string, string>;
+  /**
+   * Slow path only: called with the handler's SSE response headers once it resolves; a returned
+   * frame is written just before the forwarded body. The committed head cannot carry headers the
+   * handler set late (route provenance), so OpenAI chat passes `openAiRouteProvenanceFrame`.
+   */
+  provenanceFrame?: (headers: Headers) => Uint8Array | null;
   /**
    * Frame emitted if the handler ultimately fails (or the upstream stream dies
    * mid-flight with zero bytes forwarded) after the slow path has already
@@ -680,6 +715,17 @@ export async function withEarlyStreamKeepalive(
           const isSse = contentType.includes("text/event-stream");
 
           if (response.body && isSse) {
+            // Headers the committed head could not carry go in-band first (never fails the stream).
+            let lateHeaders: Uint8Array | null = null;
+            try {
+              lateHeaders = options.provenanceFrame?.(response.headers) ?? null;
+            } catch {
+              lateHeaders = null;
+            }
+            if (lateHeaders) {
+              controller.enqueue(lateHeaders);
+              recordClientBytes(lateHeaders);
+            }
             // Real SSE stream — forward it verbatim.
             upstreamReader = response.body.getReader();
             let bytesForwarded = 0;
