@@ -1,6 +1,6 @@
 import test from "node:test";
 import assert from "node:assert/strict";
-import { withEarlyStreamKeepalive } from "../../open-sse/utils/earlyStreamKeepalive.ts";
+import { openAiRouteProvenanceFrame, withEarlyStreamKeepalive } from "../../open-sse/utils/earlyStreamKeepalive.ts";
 
 const ENCODER = new TextEncoder();
 const DECODER = new TextDecoder();
@@ -162,3 +162,51 @@ test("client abort stops keepalive and closes stream", async () => {
   // Should have received some keepalive frames then closed
   assert.ok(text.length >= 0, "stream should close on abort");
 });
+
+// ── Route provenance on the slow path (jev-router patch 0009) ─────────────
+// A plugin-routed combo stamps x-omniroute-route & co on its response (patch 0007). When the
+// handler is slower than the threshold the 200 head is already committed, so those headers are
+// carried in-band as one choices-less chunk, written just before the forwarded body.
+
+const routed = (headers: Record<string, string>) =>
+  new Response(makeSseStream(['data: {"choices":[{"delta":{"content":"hi"}}]}\n\n', "data: [DONE]\n\n"]), {
+    status: 200,
+    headers: { "content-type": "text/event-stream", ...headers },
+  });
+const provenanceHeaders = {
+  "x-omniroute-route": "ocpaid/opencode-go/deepseek-v4.1-flash",
+  "x-omniroute-attempts": "2",
+  "x-router-reason": "jev",
+  "x-router-confidence": "0.82",
+};
+
+test("slow path: route provenance headers are sent in-band before the body", async () => {
+  const delayed = new Promise<Response>((resolve) => setTimeout(() => resolve(routed(provenanceHeaders)), 60));
+  const result = await withEarlyStreamKeepalive(delayed, { thresholdMs: 10, intervalMs: 1000, provenanceFrame: openAiRouteProvenanceFrame });
+  const text = await drainStream(result.body!);
+  const frames = text.split("\n\n").filter((f) => f.startsWith("data: {"));
+  const meta = frames.map((f) => JSON.parse(f.slice(6))).find((c) => c.x_omniroute);
+  assert.deepEqual(meta?.x_omniroute, { route: "ocpaid/opencode-go/deepseek-v4.1-flash", attempts: "2", reason: "jev", confidence: "0.82" });
+  assert.deepEqual(meta?.choices, []);
+  assert.equal(meta?.model, "keepalive");
+  assert.ok(text.indexOf("x_omniroute") < text.indexOf('"content":"hi"'), "the provenance frame precedes the body");
+});
+
+test("slow path: no route header, no provenance frame", async () => {
+  const delayed = new Promise<Response>((resolve) => setTimeout(() => resolve(routed({})), 60));
+  const result = await withEarlyStreamKeepalive(delayed, { thresholdMs: 10, intervalMs: 1000, provenanceFrame: openAiRouteProvenanceFrame });
+  assert.ok(!(await drainStream(result.body!)).includes("x_omniroute"));
+});
+
+test("fast path: provenance stays in the headers and the body is untouched", async () => {
+  const result = await withEarlyStreamKeepalive(Promise.resolve(routed(provenanceHeaders)), { thresholdMs: 5000, provenanceFrame: openAiRouteProvenanceFrame });
+  assert.equal(result.headers.get("x-omniroute-route"), "ocpaid/opencode-go/deepseek-v4.1-flash");
+  assert.ok(!(await drainStream(result.body!)).includes("x_omniroute"));
+});
+
+test("the provenance frame carries only the allowlisted routing headers", () => {
+  const frame = openAiRouteProvenanceFrame(new Headers({ ...provenanceHeaders, authorization: "Bearer secret", "x-other": "v" }));
+  const chunk = JSON.parse(new TextDecoder().decode(frame!).replace(/^data: /, ""));
+  assert.deepEqual(Object.keys(chunk.x_omniroute).sort(), ["attempts", "confidence", "reason", "route"]);
+  assert.equal(openAiRouteProvenanceFrame(new Headers({ "x-router-reason": "static" })), null);
+});
