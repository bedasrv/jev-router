+              // indicator read: attribute (aria-label) when set, else textContent
+              const entry = script.selectors?.[opts.selector as string];
+              if (!entry?.found) return false;
+              try {
+                const re = new RegExp(opts.pattern as string, (opts.flags as string) || "i");
