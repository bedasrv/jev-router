@@ -235,7 +263,6 @@ export async function selectGeminiUiMode(
 
   const {
     toggleSelector,
-    menuPresenceSelector,
     menuItemPattern,
     menuItemPatternFlags,
     menuItemSelector,
@@ -247,64 +274,62 @@ export async function selectGeminiUiMode(
     return { confirmed: false, reason: "control_not_found", descriptor };
   }
 
-  // Angular re-renders the picker button between query and click
-  // ("elementHandle.click: Element is not attached to the DOM") — re-query and
-  // retry instead of trusting one handle.
-  let toggleClicked = false;
-  for (let attempt = 0; attempt < 3 && !toggleClicked; attempt++) {
-    const toggle = await page.waitForSelector(toggleSelector, { timeout: timeoutMs }).catch(() => null);
-    if (!toggle) return { confirmed: false, reason: "control_not_found", descriptor };
-    try {
-      await toggle.click();
-      toggleClicked = true;
-    } catch {
-      await page.waitForTimeout(100);
-    }
-  }
-  if (!toggleClicked) return { confirmed: false, reason: "control_not_found", descriptor };
+  // Control presence (fail-closed "not found" when the picker is absent entirely)
+  const toggle = await page
+    .waitForSelector(toggleSelector, { timeout: timeoutMs })
+    .catch(() => null);
+  if (!toggle) return { confirmed: false, reason: "control_not_found", descriptor };
+
+  const itemSelector = menuItemSelector ?? GEMINI_MENU_ITEM_SELECTOR;
+
+  // All interaction runs in-page against freshly-queried nodes: Angular detaches
+  // and re-creates the picker during hydration, so ElementHandle clicks land on
+  // dead nodes and the menu never opens (observed intermittently under Docker
+  // load — roughly every other request). Up to 3 attempts of the whole
+  // open -> pick -> read-back cycle.
+  let pickedAtLeastOnce = false;
 
-  if (menuItemPattern) {
-    // Menu picker: wait for the menu, then click this mode's entry by pattern.
-    const menuSelector = menuPresenceSelector ?? menuItemSelector ?? GEMINI_MENU_ITEM_SELECTOR;
-    const menuOpen = await page.waitForSelector(menuSelector, { timeout: timeoutMs }).catch(() => null);
-    if (!menuOpen) return { confirmed: false, reason: "control_not_found", descriptor };
+  for (let attempt = 1; attempt <= 3; attempt++) {
+    const opened = (await page.evaluate(
+      clickGeminiModePickerInPage as unknown as (...args: never[]) => unknown,
+      { buttonSelector: toggleSelector, waitMs: 3000 }
+    )) as boolean;
+    if (!opened) continue;
+
+    if (menuItemPattern) {
+      const picked = (await page.evaluate(
+        clickGeminiMenuItemInPage as unknown as (...args: never[]) => unknown,
+        {
+          pattern: menuItemPattern,
+          flags: menuItemPatternFlags ?? "i",
+          itemSelector,
+          waitMs: 5000,
+        }
+      )) as boolean;
+      if (!picked) continue;
+      pickedAtLeastOnce = true;
+    }
 
-    const clicked = (await page.evaluate(
-      clickGeminiMenuItemInPage as unknown as (...args: never[]) => unknown,
+    const confirmed = (await page.evaluate(
+      readGeminiModeIndicatorInPage as unknown as (...args: never[]) => unknown,
       {
-        pattern: menuItemPattern,
-        flags: menuItemPatternFlags ?? "i",
-        itemSelector: menuItemSelector ?? GEMINI_MENU_ITEM_SELECTOR,
+        selector: activeIndicatorSelector,
+        attribute: indicatorAttribute ?? null,
+        pattern: expectedIndicatorPattern.source,
+        flags: expectedIndicatorPattern.flags,
+        waitMs: timeoutMs,
       }
     )) as boolean;
-    if (!clicked) return { confirmed: false, reason: "control_not_found", descriptor };
+    if (confirmed) return { confirmed: true, descriptor };
   }
 
-  const indicator = await page
-    .waitForSelector(activeIndicatorSelector, { timeout: timeoutMs })
-    .catch(() => null);
-  if (!indicator) return { confirmed: false, reason: "indicator_not_found", descriptor };
-
-  // Angular needs a tick to flip the picker's aria-label after the click —
-  // re-query the indicator each poll (the handle may detach) until the pattern
-  // confirms or the budget runs out.
-  const deadline = Date.now() + timeoutMs;
-  while (true) {
-    const el = await page
-      .waitForSelector(activeIndicatorSelector, { timeout: 250 })
-      .catch(() => null);
-    const text = el
-      ? indicatorAttribute
-        ? await readIndicatorAttribute(el, indicatorAttribute)
-        : await readIndicatorText(el)
-      : null;
-    if (text && expectedIndicatorPattern.test(text)) {
-      return { confirmed: true, descriptor };
-    }
-    if (Date.now() >= deadline) break;
-    await page.waitForTimeout(100);
-  }
-  return { confirmed: false, reason: "indicator_mismatch", descriptor };
+  // Menu item never landed -> the control itself was unusable; item landed but
+  // never confirmed -> read-back mismatch. Both fail closed (#13381).
+  return {
+    confirmed: false,
+    reason: menuItemPattern && !pickedAtLeastOnce ? "control_not_found" : "indicator_mismatch",
+    descriptor,
+  };
 }
 
