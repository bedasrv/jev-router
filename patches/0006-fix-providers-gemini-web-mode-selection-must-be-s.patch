-/** Reads `attribute` off an element when set (aria-label lives there, not in textContent). */
-async function readIndicatorAttribute(
-  el: GeminiAutomationElement,
-  attribute: string
-): Promise<string | null> {
-  try {
-    const getter = (el as unknown as { getAttribute?: (a: string) => string | null })
-      .getAttribute;
-    if (typeof getter === "function") {
-      const value = await getter.call(el, attribute);
-      if (typeof value === "string") return value;
+/**
+ * In-page half of the mode-picker toggle click (see selectGeminiUiMode). Waits
+ * for the button to be present (Angular replaces it during hydration), then
+ * clicks the FRESH node — an ElementHandle from before hydration is detached
+ * by the time click() lands, which silently opened no menu. Async so it can
+ * poll inside the page. Injectable document keeps it unit-testable.
+ */
+export async function clickGeminiModePickerInPage(
+  opts: { buttonSelector: string; waitMs: number },
+  doc: Document = (globalThis as { document?: Document }).document as Document
+): Promise<boolean> {
+  const deadline = Date.now() + opts.waitMs;
+  while (Date.now() < deadline) {
+    const button = doc.querySelector(opts.buttonSelector) as HTMLElement | null;
+    if (button) {
+      button.click();
+      return true;
     }
-  } catch {
-    // Unreadable is treated the same as "did not confirm" below — never a pass.
+    await new Promise((resolve) => setTimeout(resolve, 100));
   }
-  return null;
+  return doc.querySelector(opts.buttonSelector) !== null
+    ? (() => {
+        (doc.querySelector(opts.buttonSelector) as HTMLElement).click();
+        return true;
+      })()
+    : false;
 }
 
-async function readIndicatorText(el: GeminiAutomationElement): Promise<string | null> {
+/**
+ * In-page half of the menu-item click (see selectGeminiUiMode). Waits for a
+ * menu item whose innerText matches the pattern, then clicks it. The live menu
+ * can take several seconds to render its items after the picker opens, and the
+ * page also contains OTHER gem-menus (e.g. the thinking-level submenu), so a
+ * single-shot query is not enough. Async so it can poll inside the page.
+ */
+export async function clickGeminiMenuItemInPage(
+  opts: { pattern: string; flags: string; itemSelector: string; waitMs: number },
+  doc: Document = (globalThis as { document?: Document }).document as Document
+): Promise<boolean> {
+  let re: RegExp;
   try {
-    if (typeof el.textContent === "function") {
-      const text = await el.textContent();
-      if (typeof text === "string") return text;
-    }
-    if (typeof el.innerText === "function") {
-      return await el.innerText();
-    }
+    re = new RegExp(opts.pattern, opts.flags);
   } catch {
-    // Unreadable is treated the same as "did not confirm" below — never a pass.
+    return false;
+  }
+  const deadline = Date.now() + opts.waitMs;
+  while (Date.now() < deadline) {
+    const items = Array.from(doc.querySelectorAll(opts.itemSelector)) as HTMLElement[];
+    const target = items.find((item) => re.test((item.innerText || "").trim()));
+    if (target) {
+      target.click();
+      return true;
+    }
+    await new Promise((resolve) => setTimeout(resolve, 100));
   }
-  return null;
+  return false;
 }
 
 /**
- * In-page half of the menu-item click (see selectGeminiUiMode). Finds the first
- * menu item whose innerText matches the pattern and clicks it. Kept as a plain
- * function with an injectable document for unit tests; serialized through
- * page.evaluate with exactly ONE argument (the options object).
+ * In-page read of the active-mode indicator: polls the element's attribute
+ * (aria-label) until the pattern confirms. Async so the whole read-back is a
+ * single evaluate round-trip.
  */
-export function clickGeminiMenuItemInPage(
-  opts: { pattern: string; flags: string; itemSelector: string },
+export async function readGeminiModeIndicatorInPage(
+  opts: { selector: string; attribute?: string | null; pattern: string; flags: string; waitMs: number },
   doc: Document = (globalThis as { document?: Document }).document as Document
-): boolean {
+): Promise<boolean> {
   let re: RegExp;
   try {
     re = new RegExp(opts.pattern, opts.flags);
   } catch {
     return false;
   }
-  const items = Array.from(doc.querySelectorAll(opts.itemSelector)) as HTMLElement[];
-  const target = items.find((item) => re.test((item.innerText || "").trim()));
-  if (!target) return false;
-  target.click();
-  return true;
+  const deadline = Date.now() + opts.waitMs;
+  while (Date.now() < deadline) {
+    const el = doc.querySelector(opts.selector) as HTMLElement | null;
+    const value = opts.attribute
+      ? el?.getAttribute?.(opts.attribute) ?? null
+      : (el?.innerText ?? "").trim();
+    if (value && re.test(value)) return true;
+    await new Promise((resolve) => setTimeout(resolve, 100));
+  }
+  return false;
 }
 
