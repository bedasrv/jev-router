+/** Record the HTTP-level result of one dispatched attempt (called for every attempt, success or failure). */
+export function recordComboOutcome(
+  invocationId: string,
+  entry: Omit<ComboOutcomeEntry, "ts">
+): void {
+  const trace = traces.get(invocationId);
+  if (!trace) return;
+  trace.outcomes.push({ ...entry, ts: Date.now() });
+}
