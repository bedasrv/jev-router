+import { createInvocationId, getComboTrace } from "@omniroute/open-sse/services/combo/decisionTrace.ts";
+
 type LoggerLike =
   | {
       info?: (...args: unknown[]) => void;
@@ -81,9 +83,54 @@ export function buildPluginRouteCombo(requestedModel: string, models: string[],
     // The list IS the fallback order: hop to the next model at once. (OmniRoute already rotates
     // accounts inside one attempt; the default same-model retry would add a 2 s stall per dead member.)
     config: { maxRetries: 0 },
+    // lets chat.ts read this invocation's per-attempt outcomes back for onRouteResult
+    traceInvocationId: createInvocationId(),
     isHidden: true,
     isActive: true,
     sortOrder: 0,
     version: 1,
   };
 }
+
+/**
+ * onRouteResult: after the plugin-routed combo finished, tell the plugin how each dispatched target
+ * went (HTTP status + allowlisted kind, never an error body) and which targets OmniRoute skipped.
+ * Fire-and-forget: never awaited by the request, never throws.
+ */
+export function emitPluginRouteResult(args: {
+  requestId: string;
+  requestedModel: string;
+  combo: { traceInvocationId?: string; models: Array<{ model: string }> };
+  response: { status: number };
+  log?: LoggerLike;
+}): void {
+  void (async () => {
+    try {
+      const id = args.combo.traceInvocationId;
+      const trace = id ? getComboTrace(id) : null;
+      if (!trace) return;
+      const { runOnRouteResult } = await import("@/lib/plugins/hooks");
+      await runOnRouteResult({
+        requestId: args.requestId,
+        model: args.requestedModel,
+        status: args.response.status,
+        listed: args.combo.models.map((m) => m.model),
+        attempts: trace.outcomes.map((o) => ({
+          model: o.target,
+          ok: o.ok,
+          status: o.status,
+          kind: o.kind,
+          latencyMs: o.latencyMs,
+        })),
+        skipped: trace.decisions
+          .filter((d) => d.decision === "skipped_before_dispatch")
+          .map((d) => ({ model: d.target, reason: d.reason ?? "unknown" })),
+      });
+    } catch (err) {
+      args.log?.debug?.(
+        "PLUGIN",
+        `onRouteResult error (non-fatal): ${err instanceof Error ? err.message : String(err)}`
+      );
+    }
+  })();
+}
