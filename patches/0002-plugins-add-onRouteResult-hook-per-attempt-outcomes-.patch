+// ── onRouteResult event types ──
+
+/** One dispatched attempt of the combo built from an onRoute answer. */
+export interface PluginRouteOutcome {
+  /** The model id as the plugin returned it (the combo step's model string). */
+  model: string;
+  ok: boolean;
+  status: number | null;
+  /** auth | rate_limit | timeout | provider | model | ... (null on success). Never an error body. */
+  kind: string | null;
+  latencyMs: number;
+}
+
+/**
+ * onRouteResult: fire-and-forget, sent once per request whose model list came from an onRoute plugin,
+ * after the combo finished (success or exhausted). Lets the plugin learn which of its picks failed.
+ */
+export interface PluginRouteResultPayload {
+  requestId: string;
+  /** The model the client asked for (e.g. "free" / "paid"). */
+  model: string;
+  /** Final HTTP status of the combo response. */
+  status: number;
+  /** Models the plugin listed, in order. */
+  listed: string[];
+  /** Dispatched attempts in the order they ran. */
+  attempts: PluginRouteOutcome[];
+  /** Targets OmniRoute skipped before dispatch (cooldown, lockout, ...), with its allowlisted reason. */
+  skipped: Array<{ model: string; reason: string }>;
+}
+
+/** Run onRouteResult hooks — fire-and-forget notification. */
+export async function runOnRouteResult(payload: PluginRouteResultPayload): Promise<void> {
+  await emitHook("onRouteResult", payload);
 }
 
