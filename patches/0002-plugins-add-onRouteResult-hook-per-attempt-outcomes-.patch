+  assert.deepEqual(got.listed, ["ocfree/x", "ocpv/y", "ocfree/z"]);
+  assert.deepEqual(got.attempts.map((a: any) => [a.model, a.ok, a.status, a.kind]), [["ocfree/x", false, 403, "auth"], ["ocpv/y", true, 200, null]]);
+  assert.deepEqual(got.skipped, [{ model: "ocfree/z", reason: "provider_cooldown" }]);
+});
+
+test("emitPluginRouteResult swallows a throwing handler and a missing trace", async () => {
+  const combo = buildPluginRouteCombo("free", ["p/a"], "r7");
+  registerHook("onRouteResult", "boom", () => { throw new Error("x"); }, 1);
+  assert.doesNotThrow(() => emitPluginRouteResult({ requestId: "r7", requestedModel: "free", combo, response: { status: 502 } })); // no trace yet
+  startComboTrace(String(combo.traceInvocationId), { strategy: "priority", comboName: "free" });
+  assert.doesNotThrow(() => emitPluginRouteResult({ requestId: "r7", requestedModel: "free", combo, response: { status: 502 } }));
+  await new Promise((r) => setTimeout(r, 30));
+});
