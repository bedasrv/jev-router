From 0d8150e460fa8694475c0475e7fc8401e1fcfa07 Mon Sep 17 00:00:00 2001
From: bedasrv <email@farrel.xyz>
Date: Fri, 23 Oct 2026 10:07:29 +0700
Subject: [PATCH] fix(executors): FETCH_START_TIMEOUT_CAP_MS replaces the 110s
 streaming fetch-start cap for providers without their own

A custom OpenAI-compatible node registers no fetchStartTimeoutCapMs, so every streaming request to it had
its headers-wait cut at 110s (Codex's patience) and failed over, even when the operator's clients allow a
reasoning model far longer before its first byte. The env value replaces that default; 0 turns the cap off
so FETCH_TIMEOUT_MS applies; unset keeps 110s. A provider's own cap still wins.
---
 open-sse/utils/fetchStartTimeoutPolicy.ts | 15 +++++++++++-
 tests/unit/fetch-start-cap-env.test.ts    | 30 +++++++++++++++++++++++
 2 files changed, 44 insertions(+), 1 deletion(-)
 create mode 100644 tests/unit/fetch-start-cap-env.test.ts

diff --git a/open-sse/utils/fetchStartTimeoutPolicy.ts b/open-sse/utils/fetchStartTimeoutPolicy.ts
index 3ebe79f0..30f15821 100644
--- a/open-sse/utils/fetchStartTimeoutPolicy.ts
+++ b/open-sse/utils/fetchStartTimeoutPolicy.ts
@@ -35,6 +35,19 @@ export type FetchStartTimeoutPolicyResult = {
 export const CODEX_CLIENT_ABORT_MS = 120_000;
 export const DEFAULT_FETCH_START_TIMEOUT_CAP_MS = 110_000;
 
+// FETCH_START_TIMEOUT_CAP_MS replaces the default cap for providers that register no cap of their own
+// (custom OpenAI-compatible nodes): a deployment whose clients wait longer than Codex does (an agent that
+// allows a reasoning model 15 minutes before its first byte) would otherwise have every slow start cut at
+// 110s and failed over. 0 turns the cap off, so the flat FETCH_TIMEOUT_MS applies. Unset keeps 110s.
+export function defaultFetchStartTimeoutCapMs(
+  env: Record<string, string | undefined> = process.env
+): number {
+  const raw = env.FETCH_START_TIMEOUT_CAP_MS;
+  if (raw == null || raw.trim() === "") return DEFAULT_FETCH_START_TIMEOUT_CAP_MS;
+  const parsed = Number(raw);
+  return Number.isFinite(parsed) && parsed >= 0 ? Math.floor(parsed) : DEFAULT_FETCH_START_TIMEOUT_CAP_MS;
+}
+
 export function resolveFetchStartTimeout(
   input: FetchStartTimeoutPolicyInput
 ): FetchStartTimeoutPolicyResult {
@@ -43,7 +56,7 @@ export function resolveFetchStartTimeout(
     return { timeoutMs: baseTimeoutMs, baseTimeoutMs, capped: false };
   }
 
-  const capMs = Math.max(0, Math.floor(input.capMs ?? DEFAULT_FETCH_START_TIMEOUT_CAP_MS));
+  const capMs = Math.max(0, Math.floor(input.capMs ?? defaultFetchStartTimeoutCapMs()));
   if (capMs <= 0 || baseTimeoutMs <= capMs) {
     return { timeoutMs: baseTimeoutMs, baseTimeoutMs, capped: false };
   }
diff --git a/tests/unit/fetch-start-cap-env.test.ts b/tests/unit/fetch-start-cap-env.test.ts
new file mode 100644
index 00000000..2cec36dd
--- /dev/null
+++ b/tests/unit/fetch-start-cap-env.test.ts
@@ -0,0 +1,30 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  DEFAULT_FETCH_START_TIMEOUT_CAP_MS,
+  defaultFetchStartTimeoutCapMs,
+  resolveFetchStartTimeout,
+} from "../../open-sse/utils/fetchStartTimeoutPolicy.ts";
+
+test("FETCH_START_TIMEOUT_CAP_MS: unset or invalid keeps the 110s default", () => {
+  assert.equal(defaultFetchStartTimeoutCapMs({}), DEFAULT_FETCH_START_TIMEOUT_CAP_MS);
+  assert.equal(defaultFetchStartTimeoutCapMs({ FETCH_START_TIMEOUT_CAP_MS: " " }), DEFAULT_FETCH_START_TIMEOUT_CAP_MS);
+  assert.equal(defaultFetchStartTimeoutCapMs({ FETCH_START_TIMEOUT_CAP_MS: "soon" }), DEFAULT_FETCH_START_TIMEOUT_CAP_MS);
+  assert.equal(defaultFetchStartTimeoutCapMs({ FETCH_START_TIMEOUT_CAP_MS: "-1" }), DEFAULT_FETCH_START_TIMEOUT_CAP_MS);
+});
+
+test("FETCH_START_TIMEOUT_CAP_MS: a value replaces the default for providers without their own cap; 0 turns it off", () => {
+  const before = process.env.FETCH_START_TIMEOUT_CAP_MS;
+  try {
+    process.env.FETCH_START_TIMEOUT_CAP_MS = "900000";
+    assert.deepEqual(resolveFetchStartTimeout({ baseTimeoutMs: 1_200_000, stream: true }), { timeoutMs: 900_000, baseTimeoutMs: 1_200_000, capped: true });
+    assert.deepEqual(resolveFetchStartTimeout({ baseTimeoutMs: 600_000, stream: true }), { timeoutMs: 600_000, baseTimeoutMs: 600_000, capped: false });
+    process.env.FETCH_START_TIMEOUT_CAP_MS = "0";
+    assert.deepEqual(resolveFetchStartTimeout({ baseTimeoutMs: 900_000, stream: true }), { timeoutMs: 900_000, baseTimeoutMs: 900_000, capped: false });
+    // A provider's own cap still wins over the env default.
+    assert.equal(resolveFetchStartTimeout({ baseTimeoutMs: 900_000, stream: true, capMs: 600_000 }).timeoutMs, 600_000);
+  } finally {
+    if (before === undefined) delete process.env.FETCH_START_TIMEOUT_CAP_MS;
+    else process.env.FETCH_START_TIMEOUT_CAP_MS = before;
+  }
+});
-- 
