@@ -322,6 +344,39 @@ function ensurePluginsLoaded(): Promise<void> {
   return pluginBoot;
 }
 
+/**
+ * Run onRoute hooks in priority order; the first handler returning a non-empty list of
+ * model-id strings wins. Handler errors are logged and skipped (fail-open).
+ */
+export async function runOnRoute(ctx: PluginRouteContext): Promise<PluginRouteResult | null> {
+  await ensurePluginsLoaded();
+  const list = hooks.get("onRoute") || [];
+  for (const reg of list) {
+    if (isRateLimited(reg.pluginName)) {
+      log.warn("hook.route_rate_limited", { pluginName: reg.pluginName });
+      continue;
+    }
+    try {
+      const result = (await reg.handler(ctx)) as PluginRouteResult | void;
+      if (
+        result &&
+        typeof result === "object" &&
+        Array.isArray(result.models) &&
+        result.models.length > 0 &&
+        result.models.every((m) => typeof m === "string" && m.length > 0)
+      ) {
+        return result;
+      }
+    } catch (err: unknown) {
+      log.error("hook.route_handler_error", {
+        pluginName: reg.pluginName,
+        error: err instanceof Error ? err.message : String(err),
+      });
+    }
+  }
+  return null;
+}
+
 /**
  * Run onRequest hooks — blocking. Plugins can modify body/metadata or block with 403.
