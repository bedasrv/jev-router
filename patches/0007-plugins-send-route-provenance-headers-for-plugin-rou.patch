+test("buildPluginRouteHeaders: successful target, attempt count, jev reason and confidence", () => {
+  const combo = buildPluginRouteCombo("paid", ["a/x", "b/y"], "r8", { reason: "jev", confidence: 0.8765 });
+  const id = String(combo.traceInvocationId);
+  startComboTrace(id, { strategy: "priority", comboName: "paid" });
+  recordComboOutcome(id, { target: "a/x", ok: false, status: 502, kind: "provider", latencyMs: 80 });
+  recordComboOutcome(id, { target: "b/y", ok: true, status: 200, kind: null, latencyMs: 900 });
+  assert.deepEqual(buildPluginRouteHeaders(combo), {
+    "x-omniroute-route": "b/y",
+    "x-omniroute-attempts": "2",
+    "x-router-reason": "jev",
+    "x-router-confidence": "0.877",
+  });
+});
+
+test("buildPluginRouteHeaders: static keeps the reason but never the confidence", () => {
+  const combo = buildPluginRouteCombo("paid", ["a/x"], "r9", { reason: "static:cont", confidence: 0.9 });
+  const id = String(combo.traceInvocationId);
+  startComboTrace(id, { strategy: "priority", comboName: "paid" });
+  recordComboOutcome(id, { target: "a/x", ok: true, status: 200, kind: null, latencyMs: 10 });
+  assert.deepEqual(buildPluginRouteHeaders(combo), {
+    "x-omniroute-route": "a/x",
+    "x-omniroute-attempts": "1",
+    "x-router-reason": "static:cont",
+  });
+});
+
+test("buildPluginRouteHeaders: no success, unknown reason or bad confidence adds nothing unsafe", () => {
+  const combo = buildPluginRouteCombo("free", ["a/x"], "r10", { reason: "jev:paid", confidence: 2 });
+  const id = String(combo.traceInvocationId);
+  startComboTrace(id, { strategy: "priority", comboName: "free" });
+  recordComboOutcome(id, { target: "a/x", ok: false, status: 403, kind: "auth", latencyMs: 10 });
+  assert.deepEqual(buildPluginRouteHeaders(combo), {}); // no successful attempt
+  recordComboOutcome(id, { target: "a/x", ok: true, status: 200, kind: null, latencyMs: 20 });
+  assert.deepEqual(buildPluginRouteHeaders(combo), {
+    "x-omniroute-route": "a/x",
+    "x-omniroute-attempts": "2",
+  }); // reason not in the allowlist, confidence out of range
+});
+
+test("withPluginRouteHeaders stamps a Response and leaves failed/foreign combos untouched", () => {
+  const combo = buildPluginRouteCombo("paid", ["a/x"], "r11", { reason: "static" });
+  const id = String(combo.traceInvocationId);
+  startComboTrace(id, { strategy: "priority", comboName: "paid" });
+  recordComboOutcome(id, { target: "a/x", ok: true, status: 200, kind: null, latencyMs: 10 });
+  const response = withPluginRouteHeaders(new Response("ok"), combo);
+  assert.equal(response.headers.get("x-omniroute-route"), "a/x");
+  assert.equal(response.headers.get("x-omniroute-attempts"), "1");
+  assert.equal(response.headers.get("x-router-reason"), "static");
+  assert.equal(response.headers.get("x-router-confidence"), null);
+
+  const other = buildPluginRouteCombo("paid", ["b/y"], "r12", { reason: "jev", confidence: 0.9 });
+  startComboTrace(String(other.traceInvocationId), { strategy: "priority", comboName: "paid" });
+  recordComboOutcome(String(other.traceInvocationId), { target: "b/y", ok: false, status: 500, kind: "provider", latencyMs: 10 });
+  const failed = withPluginRouteHeaders(new Response("bad", { status: 502 }), other);
+  assert.equal(failed.headers.get("x-omniroute-route"), null);
+  assert.equal(failed.headers.get("x-router-reason"), null);
+});
+
 test("recordComboOutcome stores status/kind per attempt, in order", () => {
