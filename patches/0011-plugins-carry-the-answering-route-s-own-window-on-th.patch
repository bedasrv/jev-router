+/**
+ * tests/unit/per-route-window.test.ts
+ *
+ * Patch 0011: per-route windows on the response head. The app cannot see which route will serve a
+ * call (model choice and pools live in the router), so the answering attempt's own context_length
+ * and max_output_tokens ride the response next to x-omniroute-route: as headers when the head is
+ * not yet committed, or in-band in the x_omniroute keepalive frame when it is (patch 0009).
+ * Figures are absent when the plugin knows none — never guessed.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+
+import { registerHook, resetHooks } from "../../src/lib/plugins/hooks.ts";
+import {
+  startComboTrace,
+  recordComboOutcome,
+  resetComboTraceStore,
+} from "../../open-sse/services/combo/decisionTrace.ts";
+import {
+  buildPluginRouteCombo,
+  buildPluginRouteHeaders,
+  runPluginOnRouteHook,
+  withPluginRouteHeaders,
+} from "../../src/sse/handlers/chat/pluginOnRoute.ts";
+import {
+  openAiRouteProvenanceFrame,
+  withEarlyStreamKeepalive,
+} from "../../open-sse/utils/earlyStreamKeepalive.ts";
+
+const ENCODER = new TextEncoder();
+const DECODER = new TextDecoder();
+
+function makeSseStream(chunks: string[]): ReadableStream<Uint8Array> {
+  const encoded = chunks.map((c) => ENCODER.encode(c));
+  let idx = 0;
+  return new ReadableStream<Uint8Array>({
+    pull(controller) {
+      if (idx < encoded.length) controller.enqueue(encoded[idx++]);
+      else controller.close();
+    },
+  });
+}
+
+async function drainStream(body: ReadableStream<Uint8Array>): Promise<string> {
+  const reader = body.getReader();
+  let text = "";
+  while (true) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    text += DECODER.decode(value, { stream: true });
+  }
+  return text;
+}
+
+const routed = (headers: Record<string, string>) =>
+  new Response(
+    makeSseStream(['data: {"choices":[{"delta":{"content":"hi"}}]}\n\n', "data: [DONE]\n\n"]),
+    {
+      status: 200,
+      headers: { "content-type": "text/event-stream", ...headers },
+    }
+  );
+
+function traced(id: string, outcomes: Array<{ target: string; ok: boolean; status: number }>) {
+  startComboTrace(id, { strategy: "priority", comboName: "paid" });
+  for (const [i, o] of outcomes.entries()) {
+    recordComboOutcome(id, {
+      target: o.target,
+      ok: o.ok,
+      status: o.status,
+      kind: o.ok ? null : "provider",
+      latencyMs: 50 + i * 100,
+    });
+  }
+}
+
+test("0011: the headers name the ANSWERING attempt's figures, not the head's", () => {
+  resetComboTraceStore();
+  const combo = buildPluginRouteCombo("paid", ["a/x", "b/y"], "r40", {
+    reason: "jev",
+    confidence: 0.9,
+    windowsByModel: {
+      "a/x": { context_length: 128000, max_output_tokens: 8192 },
+      "b/y": { context_length: 1048576, max_output_tokens: 131072 },
+    },
+  });
+  traced(String(combo.traceInvocationId), [
+    { target: "a/x", ok: false, status: 502 },
+    { target: "b/y", ok: true, status: 200 },
+  ]);
+  assert.deepEqual(buildPluginRouteHeaders(combo), {
+    "x-omniroute-route": "b/y",
+    "x-omniroute-attempts": "2",
+    "x-router-reason": "jev",
+    "x-router-confidence": "0.9",
+    "x-omniroute-context-length": "1048576",
+    "x-omniroute-max-output-tokens": "131072",
+  });
+});
+
+test("0011: only usable figures for the answering attempt are echoed (a partial window keeps its good half)", () => {
+  resetComboTraceStore();
+  const combo = buildPluginRouteCombo("paid", ["a/x"], "r41", {
+    windowsByModel: {
+      "a/x": { context_length: 400000, max_output_tokens: 16384.5 },
+    },
+  });
+  traced(String(combo.traceInvocationId), [{ target: "a/x", ok: true, status: 200 }]);
+  const headers = buildPluginRouteHeaders(combo);
+  assert.equal(headers["x-omniroute-context-length"], "400000");
+  assert.equal(headers["x-omniroute-max-output-tokens"], undefined);
+});
+
+test("0011: a wire map with nothing usable for the answering attempt adds no window headers", () => {
+  resetComboTraceStore();
+  const combo = buildPluginRouteCombo("paid", ["a/x"], "r42", {
+    windowsByModel: { "a/x": { context_length: 0, max_output_tokens: -1 } } as never,
+  });
+  traced(String(combo.traceInvocationId), [{ target: "a/x", ok: true, status: 200 }]);
+  assert.deepEqual(buildPluginRouteHeaders(combo), {
+    "x-omniroute-route": "a/x",
+    "x-omniroute-attempts": "1",
+  });
+});
+
+test("0011: the wire map is normalized against the final list; figures are capped and integral", () => {
+  const combo = buildPluginRouteCombo("paid", ["a/x"], "r43", {
+    windowsByModel: {
+      "a/x": { context_length: 200000.5, max_output_tokens: 100_000_001 },
+      "b/z": { context_length: 999999, max_output_tokens: 4096 },
+    },
+  });
+  // a/x's figures are unusable; b/z is not in the final list
+  assert.deepEqual(combo.routeWindowsByModel, undefined);
+  const ok = buildPluginRouteCombo("paid", ["a/x"], "r44", {
+    windowsByModel: { "a/x": { context_length: 200000, max_output_tokens: 1 } },
+  });
+  assert.deepEqual(ok.routeWindowsByModel, {
+    "a/x": { context_length: 200000, max_output_tokens: 1 },
+  });
+});
+
+test("0011: withPluginRouteHeaders stamps the window headers beside the route headers", () => {
+  resetComboTraceStore();
+  const combo = buildPluginRouteCombo("paid", ["a/x"], "r45", {
+    reason: "static",
+    windowsByModel: { "a/x": { context_length: 131072 } },
+  });
+  traced(String(combo.traceInvocationId), [{ target: "a/x", ok: true, status: 200 }]);
+  const response = withPluginRouteHeaders(new Response("ok"), combo);
+  assert.equal(response.headers.get("x-omniroute-context-length"), "131072");
+  assert.equal(response.headers.get("x-omniroute-max-output-tokens"), null);
+  assert.equal(response.headers.get("x-omniroute-route"), "a/x");
+});
+
+test("0011: runPluginOnRouteHook keeps a windows map for listed targets only", async () => {
+  resetHooks();
+  registerHook(
+    "onRoute",
+    "p",
+    () => ({
+      models: ["a/x", "b/y"],
+      reason: "jev",
+      windows_by_model: {
+        "a/x": { context_length: 128000, max_output_tokens: 8192 },
+        "b/y": { context_length: 1048576 },
+        "z/not-listed": { context_length: 999999 },
+        "a/x/ignored": { context_length: 1 },
+      },
+    }),
+    1
+  );
+  const out = await runPluginOnRouteHook({
+    requestId: "r46",
+    body: {},
+    model: "paid",
+    apiKeyInfo: null,
+  });
+  assert.deepEqual(out?.windowsByModel, {
+    "a/x": { context_length: 128000, max_output_tokens: 8192 },
+    "b/y": { context_length: 1048576 },
+  });
+});
+
+test("0011: malformed windows are dropped, never echoed", async () => {
+  resetHooks();
+  registerHook(
+    "onRoute",
+    "p",
+    () => ({
+      models: ["a/x"],
+      windows_by_model: {
+        "a/x": { context_length: "128000", max_output_tokens: Number.NaN },
+      },
+    }),
+    1
+  );
+  const out = await runPluginOnRouteHook({
+    requestId: "r47",
+    body: {},
+    model: "paid",
+    apiKeyInfo: null,
+  });
+  assert.equal(out?.windowsByModel, undefined);
+});
+
+test("0011: the in-band provenance frame carries the answering route's window", async () => {
+  const delayed = new Promise<Response>((resolve) =>
+    setTimeout(
+      () =>
+        resolve(
+          routed({
+            "x-omniroute-route": "ocpaid/opencode-go/deepseek-v4.1-flash",
+            "x-omniroute-attempts": "2",
+            "x-omniroute-context-length": "1000000",
+            "x-omniroute-max-output-tokens": "65536",
+            "x-router-reason": "jev",
+            "x-router-confidence": "0.82",
+          })
+        ),
+      60
+    )
+  );
+  const result = await withEarlyStreamKeepalive(delayed, {
+    thresholdMs: 10,
+    intervalMs: 1000,
+    provenanceFrame: openAiRouteProvenanceFrame,
+  });
+  const text = await drainStream(result.body!);
+  const meta = text
+    .split("\n\n")
+    .filter((f) => f.startsWith("data: {"))
+    .map((f) => JSON.parse(f.slice(6)))
+    .find((c) => c.x_omniroute);
+  assert.deepEqual(meta?.x_omniroute, {
+    route: "ocpaid/opencode-go/deepseek-v4.1-flash",
+    attempts: "2",
+    context_length: "1000000",
+    max_output_tokens: "65536",
+    reason: "jev",
+    confidence: "0.82",
+  });
+});
+
+test("0011: the provenance frame carries only the allowlisted routing headers, windows included", () => {
+  const frame = openAiRouteProvenanceFrame(
+    new Headers({
+      "x-omniroute-route": "ocpaid/opencode-go/deepseek-v4.1-flash",
+      "x-omniroute-attempts": "1",
+      "x-omniroute-context-length": "1048576",
+      "x-omniroute-max-output-tokens": "131072",
+      "x-router-reason": "jev",
+      authorization: "Bearer secret",
+      "x-other": "v",
+    })
+  );
+  const chunk = JSON.parse(new TextDecoder().decode(frame!).replace(/^data: /, ""));
+  assert.deepEqual(Object.keys(chunk.x_omniroute).sort(), [
+    "attempts",
+    "context_length",
+    "max_output_tokens",
+    "reason",
+    "route",
+  ]);
+});
