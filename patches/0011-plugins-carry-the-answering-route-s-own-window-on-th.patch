+const MAX_WINDOW_TOKENS = 100_000_000;
+
+function normalizeWindowFigure(value: unknown): number | null {
+  if (typeof value !== "number" || !Number.isFinite(value)) return null;
+  if (value < 1 || value > MAX_WINDOW_TOKENS) return null;
+  if (Math.floor(value) !== value) return null;
+  return value;
+}
+
+/**
+ * Per-route windows: only targets that are in the final model list, and only finite integer figures
+ * in the sane range. A target without any usable figure is dropped; the headers are then omitted for
+ * it. Never a guess: what the plugin does not know stays absent.
+ */
+function normalizeWindowsByModel(
+  value: unknown,
+  models: string[]
+): Record<string, PluginRouteWindow> | null {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return null;
+  const out: Record<string, PluginRouteWindow> = {};
+  for (const model of models) {
+    if (!Object.prototype.hasOwnProperty.call(value, model)) continue;
+    const raw = (value as Record<string, unknown>)[model];
+    if (!raw || typeof raw !== "object" || Array.isArray(raw)) continue;
+    const record = raw as Record<string, unknown>;
+    const entry: PluginRouteWindow = {};
+    const contextLength = normalizeWindowFigure(record.context_length);
+    const maxOutputTokens = normalizeWindowFigure(record.max_output_tokens);
+    if (contextLength) entry.context_length = contextLength;
+    if (maxOutputTokens) entry.max_output_tokens = maxOutputTokens;
+    if (Object.keys(entry).length) out[model] = entry;
+  }
+  return Object.keys(out).length ? out : null;
+}
