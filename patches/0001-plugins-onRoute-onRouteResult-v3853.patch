+  assert.equal(headers["x-omniroute-max-output-tokens"], undefined);
+});
+
+test("0011: a wire map with nothing usable for the answering attempt adds no window headers", () => {
+  resetComboTraceStore();
+  const combo = buildPluginRouteCombo("paid", ["a/x"], "r42", {
+    windowsByModel: { "a/x": { context_length: 0, max_output_tokens: -1 } } as never,
+  });
