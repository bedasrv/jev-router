+++ b/tests/unit/plugins-onroute.test.ts
@@ -0,0 +1,605 @@
+/**
+ * tests/unit/plugins-onroute.test.ts
+ *
+ * onRoute hook: first handler with a non-empty string[] wins, errors/garbage fall through
+ * (fail-open), and the helper builds a stored-shape priority combo from the list.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+
+import { registerHook, runOnRoute, resetHooks } from "../../src/lib/plugins/hooks.ts";
+import {
+  startComboTrace,
+  recordComboDecision,
+  recordComboOutcome,
+  getComboTrace,
+  resetComboTraceStore,
+} from "../../open-sse/services/combo/decisionTrace.ts";
+import {
+  applyPluginRouteThinking,
+  buildPluginRouteCombo,
+  buildPluginRouteHeaders,
+  emitPluginRouteResult,
+  pluginAttemptThinking,
+  runPluginOnRouteHook,
+  withPluginRouteHeaders,
+  MAX_PLUGIN_ROUTE_MODELS,
+} from "../../src/sse/handlers/chat/pluginOnRoute.ts";
+
+const ctx = { requestId: "r1", body: { model: "paid" }, model: "paid" };
+
+test.afterEach(() => {
+  resetHooks();
+  resetComboTraceStore();
+});
+
+test("runOnRoute returns null with no handlers", async () => {
+  assert.equal(await runOnRoute(ctx), null);
+});
+
+test("runOnRoute: first non-empty list wins, priority order", async () => {
+  registerHook("onRoute", "late", () => ({ models: ["b/late"] }), 20);
+  registerHook("onRoute", "early", () => ({ models: ["a/one", "a/two"] }), 10);
+  const r = await runOnRoute(ctx);
+  assert.deepEqual(r?.models, ["a/one", "a/two"]);
+});
+
+test("runOnRoute fails open: throw, empty, non-array and non-string entries are skipped", async () => {
+  registerHook(
+    "onRoute",
+    "boom",
+    () => {
+      throw new Error("x");
+    },
+    1
+  );
+  registerHook("onRoute", "empty", () => ({ models: [] }), 2);
+  registerHook("onRoute", "junk", () => ({ models: [1, 2] as unknown as string[] }), 3);
+  registerHook("onRoute", "none", () => undefined, 4);
+  registerHook("onRoute", "ok", () => ({ models: ["p/m"], reason: "r" }), 5);
+  const r = await runOnRoute(ctx);
+  assert.deepEqual(r?.models, ["p/m"]);
+});
+
+test("runOnRoute returns null when every handler declines", async () => {
+  registerHook(
+    "onRoute",
+    "boom",
+    () => {
+      throw new Error("x");
+    },
+    1
+  );
+  assert.equal(await runOnRoute(ctx), null);
+});
+
+test("runPluginOnRouteHook dedupes and caps the list, carrying reason/confidence", async () => {
+  const many = Array.from({ length: 30 }, (_, i) => `p/m${i}`);
+  registerHook(
+    "onRoute",
+    "p",
+    () => ({
+      models: ["p/m0", ...many],
+      reason: "jev",
+      confidence: 0.87,
+      thinking: { control: "effort", value: "high" },
+    }),
+    1
+  );
+  const out = await runPluginOnRouteHook({
+    requestId: "r2",
+    body: {},
+    model: "free",
+    apiKeyInfo: null,
+  });
+  assert.equal(out?.models.length, MAX_PLUGIN_ROUTE_MODELS);
+  assert.equal(new Set(out?.models).size, out?.models.length);
+  assert.equal(out?.models[0], "p/m0");
+  assert.equal(out?.reason, "jev");
+  assert.equal(out?.confidence, 0.87);
+  assert.deepEqual(out?.thinking, { control: "effort", value: "high" });
+});
+
+test("buildPluginRouteCombo has stored priority-combo shape, named after the request", () => {
