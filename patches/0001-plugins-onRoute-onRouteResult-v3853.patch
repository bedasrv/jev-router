+  const out = await runPluginOnRouteHook({
+    requestId: "r46",
+    body: {},
+    model: "paid",
+    apiKeyInfo: null,
+  });
+  assert.deepEqual(out?.windowsByModel, {
+    "a/x": { context_length: 128000, max_output_tokens: 8192 },
+    "b/y": { context_length: 1048576 },
+  });
+});
+
+test("0011: malformed windows are dropped, never echoed", async () => {
+  resetHooks();
+  registerHook(
+    "onRoute",
+    "p",
+    () => ({
+      models: ["a/x"],
+      windows_by_model: {
+        "a/x": { context_length: "128000", max_output_tokens: Number.NaN },
+      },
+    }),
+    1
+  );
+  const out = await runPluginOnRouteHook({
+    requestId: "r47",
+    body: {},
+    model: "paid",
+    apiKeyInfo: null,
+  });
+  assert.equal(out?.windowsByModel, undefined);
+});
+
+test("0011: the in-band provenance frame carries the answering route's window", async () => {
+  const delayed = new Promise<Response>((resolve) =>
+    setTimeout(
+      () =>
+        resolve(
+          routed({
+            "x-omniroute-route": "ocpaid/opencode-go/deepseek-v4.1-flash",
+            "x-omniroute-attempts": "2",
+            "x-omniroute-context-length": "1000000",
+            "x-omniroute-max-output-tokens": "65536",
+            "x-router-reason": "jev",
+            "x-router-confidence": "0.82",
+          })
+        ),
+      60
+    )
+  );
+  const result = await withEarlyStreamKeepalive(delayed, {
+    thresholdMs: 10,
+    intervalMs: 1000,
+    provenanceFrame: openAiRouteProvenanceFrame,
+  });
+  const text = await drainStream(result.body!);
+  const meta = text
+    .split("\n\n")
+    .filter((f) => f.startsWith("data: {"))
+    .map((f) => JSON.parse(f.slice(6)))
+    .find((c) => c.x_omniroute);
+  assert.deepEqual(meta?.x_omniroute, {
+    route: "ocpaid/opencode-go/deepseek-v4.1-flash",
+    attempts: "2",
+    context_length: "1000000",
+    max_output_tokens: "65536",
+    reason: "jev",
+    confidence: "0.82",
+  });
