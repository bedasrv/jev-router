+
+test("0011: withPluginRouteHeaders stamps the window headers beside the route headers", () => {
+  resetComboTraceStore();
+  const combo = buildPluginRouteCombo("paid", ["a/x"], "r45", {
+    reason: "static",
+    windowsByModel: { "a/x": { context_length: 131072 } },
+  });
+  traced(String(combo.traceInvocationId), [{ target: "a/x", ok: true, status: 200 }]);
+  const response = withPluginRouteHeaders(new Response("ok"), combo);
+  assert.equal(response.headers.get("x-omniroute-context-length"), "131072");
+  assert.equal(response.headers.get("x-omniroute-max-output-tokens"), null);
+  assert.equal(response.headers.get("x-omniroute-route"), "a/x");
+});
+
+test("0011: runPluginOnRouteHook keeps a windows map for listed targets only", async () => {
+  resetHooks();
+  registerHook(
