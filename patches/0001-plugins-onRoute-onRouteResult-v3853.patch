+/**
+ * Plugin `onRoute` hook for the chat handler.
+ *
+ * Runs before model/combo resolution. A plugin may answer with an ordered list of explicit
+ * model ids; they become an in-memory priority combo, so every existing combo behaviour
+ * (per-target API-key policy, connection selection, cooldowns, fallback) applies unchanged.
+ * Fail-open: no plugin, no answer, or any error leaves routing exactly as it was.
+ */
+
+import {
+  createInvocationId,
+  getComboTrace,
+  type ComboTrace,
+} from "@omniroute/open-sse/services/combo/decisionTrace.ts";
+
+type LoggerLike =
+  | {
+      info?: (...args: unknown[]) => void;
+      warn?: (...args: unknown[]) => void;
+      debug?: (...args: unknown[]) => void;
+    }
+  | null
+  | undefined;
+
+type PluginThinking = { control: "effort" | "toggle" | "none"; value?: string };
+
+type PluginRouteWindow = { context_length?: number; max_output_tokens?: number };
+
+type PluginRouteMetadata = {
+  reason?: string;
+  confidence?: number;
+  thinking?: PluginThinking;
+  /** Per-attempt thinking by target id (patch 0010); replaces `thinking` for the body when present. */
+  thinkingByModel?: Record<string, PluginThinking>;
+  /** The plugin's menu item id, echoed as `x-router-item`. */
+  item?: string;
+  /** Whether the item is a specialist, echoed as `x-router-specialist` next to the item. */
+  specialist?: boolean;
+  /**
+   * Per-route windows by target id (patch 0011); echoed for the answering attempt as
+   * x-omniroute-context-length / x-omniroute-max-output-tokens.
+   */
+  windowsByModel?: Record<string, PluginRouteWindow>;
+};
+
+/** The plugin's answer after API-key filtering. `reason`/`confidence` are routing provenance. */
+export interface PluginRouteSelection extends PluginRouteMetadata {
+  models: string[];
+}
+
+/**
+ * Combo shape used by the response-header helper. The provenance fields never leave this process
+ * except as the two allowlisted `x-router-*` headers.
+ */
+type PluginRouteComboLike = PluginRouteMetadata & {
+  traceInvocationId?: string;
+  models: Array<{ model: string }>;
+  routeThinking?: PluginThinking;
+  routeThinkingByModel?: Record<string, PluginThinking>;
+  routeItem?: string;
+  routeSpecialist?: boolean;
+  routeWindowsByModel?: Record<string, PluginRouteWindow>;
+};
+
+export const MAX_PLUGIN_ROUTE_MODELS = 12;
+
+/** Allowlist the wire shape; anything malformed is dropped rather than sent upstream. */
+function normalizePluginThinking(value: unknown): PluginThinking | null {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return null;
+  const record = value as Record<string, unknown>;
+  const control = record.control;
+  if (control === "none") return { control };
+  if (control !== "effort" && control !== "toggle") return null;
+  const text = typeof record.value === "string" ? record.value.trim() : "";
+  if (!text || text.length > 32 || /[\r\n]/.test(text)) return null;
+  if (control === "toggle" && text !== "off" && text !== "on") return null;
+  return { control, value: text };
+}
+
+const ITEM_ID = /^[A-Za-z0-9_-]{1,16}$/;
+
+/** A menu item id, or null: never echoed unless it is a short plain token. */
+function normalizeRouteItem(value: unknown): string | null {
+  return typeof value === "string" && ITEM_ID.test(value) ? value : null;
+}
+
+/**
+ * Per-attempt thinking: only targets that are in the final model list, each through the same allowlist
+ * as `thinking`. A malformed entry is dropped (that attempt then gets {control:"none"}). Null when the
+ * plugin sent no usable map, so the single-`thinking` behaviour of 0008 stays.
+ */
+function normalizeThinkingByModel(
+  value: unknown,
+  models: string[]
+): Record<string, PluginThinking> | null {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return null;
+  const out: Record<string, PluginThinking> = {};
+  for (const model of models) {
+    if (!Object.prototype.hasOwnProperty.call(value, model)) continue;
+    const t = normalizePluginThinking((value as Record<string, unknown>)[model]);
+    if (t) out[model] = t;
+  }
+  return Object.keys(out).length ? out : null;
+}
+
+const MAX_WINDOW_TOKENS = 100_000_000;
+
+function normalizeWindowFigure(value: unknown): number | null {
+  if (typeof value !== "number" || !Number.isFinite(value)) return null;
+  if (value < 1 || value > MAX_WINDOW_TOKENS) return null;
+  if (Math.floor(value) !== value) return null;
+  return value;
+}
+
+/**
+ * Per-route windows: only targets that are in the final model list, and only finite integer figures
+ * in the sane range. A target without any usable figure is dropped; the headers are then omitted for
+ * it. Never a guess: what the plugin does not know stays absent.
+ */
+function normalizeWindowsByModel(
+  value: unknown,
+  models: string[]
+): Record<string, PluginRouteWindow> | null {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return null;
+  const out: Record<string, PluginRouteWindow> = {};
+  for (const model of models) {
+    if (!Object.prototype.hasOwnProperty.call(value, model)) continue;
+    const raw = (value as Record<string, unknown>)[model];
+    if (!raw || typeof raw !== "object" || Array.isArray(raw)) continue;
+    const record = raw as Record<string, unknown>;
+    const entry: PluginRouteWindow = {};
+    const contextLength = normalizeWindowFigure(record.context_length);
+    const maxOutputTokens = normalizeWindowFigure(record.max_output_tokens);
+    if (contextLength) entry.context_length = contextLength;
+    if (maxOutputTokens) entry.max_output_tokens = maxOutputTokens;
+    if (Object.keys(entry).length) out[model] = entry;
+  }
+  return Object.keys(out).length ? out : null;
+}
+
+/**
+ * The thinking one attempt of a plugin-routed combo carries: its own entry when the plugin sent a
+ * per-attempt map, {control:"none"} for a target the map leaves out, or the shared selection (0008).
+ */
+export function pluginAttemptThinking(
+  combo: PluginRouteComboLike | null | undefined,
+  model: string
+): PluginThinking | undefined {
+  if (!combo) return undefined;
+  if (combo.routeThinkingByModel) return combo.routeThinkingByModel[model] ?? { control: "none" };
+  return combo.routeThinking;
+}
+
+export async function runPluginOnRouteHook(args: {
+  requestId: string;
+  body: unknown;
+  model: string;
+  apiKeyInfo: unknown;
+  headers?: Record<string, string | string[] | undefined>;
+  /**
+   * API-key deny list. An explicit deny always wins over a plugin's choice (a combo the key may
+   * use otherwise vouches for its members, so without this a plugin could route around it).
+   */
+  isBlocked?: (model: string) => Promise<boolean>;
+  log?: LoggerLike;
+}): Promise<PluginRouteSelection | null> {
+  try {
+    const { runOnRoute } = await import("@/lib/plugins/hooks");
+    const result = await runOnRoute({
+      requestId: args.requestId,
+      body: args.body,
+      model: args.model,
+      apiKeyInfo: args.apiKeyInfo,
+      headers: args.headers,
+    });
+    if (!result?.models?.length) return null;
+    let models = [...new Set(result.models)];
+    if (args.isBlocked) {
+      const keep: string[] = [];
+      for (const m of models) if (!(await args.isBlocked(m))) keep.push(m);
+      if (keep.length !== models.length) {
+        args.log?.info?.(
+          "PLUGIN",
+          `onRoute: dropped ${models.length - keep.length} model(s) blocked by the API key`
+        );
+      }
+      models = keep;
+    }
+    models = models.slice(0, MAX_PLUGIN_ROUTE_MODELS);
+    if (models.length === 0) return null;
+    args.log?.info?.(
+      "PLUGIN",
+      `onRoute: ${args.model} → [${models.join(", ")}]${result.reason ? ` (${result.reason})` : ""}`
+    );
+    const thinking = normalizePluginThinking(result.thinking);
+    const thinkingByModel = normalizeThinkingByModel(result.thinking_by_model, models);
+    const item = normalizeRouteItem(result.item);
+    const windowsByModel = normalizeWindowsByModel(result.windows_by_model, models);
+    return {
+      models,
+      ...(typeof result.reason === "string" ? { reason: result.reason } : {}),
+      ...(typeof result.confidence === "number" ? { confidence: result.confidence } : {}),
+      ...(thinking ? { thinking } : {}),
+      ...(thinkingByModel ? { thinkingByModel } : {}),
+      ...(item ? { item } : {}),
+      ...(item && typeof result.specialist === "boolean" ? { specialist: result.specialist } : {}),
+      ...(windowsByModel ? { windowsByModel } : {}),
+    };
+  } catch (err) {
+    args.log?.debug?.(
+      "PLUGIN",
+      `onRoute hook error (non-fatal): ${err instanceof Error ? err.message : String(err)}`
+    );
+    return null;
+  }
+}
+
+/** Same document shape as a stored priority combo, never persisted. */
+export function buildPluginRouteCombo(
+  requestedModel: string,
+  models: string[],
+  requestId: string,
+  metadata: PluginRouteMetadata = {}
+) {
+  return {
+    id: `plugin-route-${requestId}`,
+    name: requestedModel,
+    strategy: "priority",
+    models: models.map((model, i) => ({
+      id: `plugin-route-${i + 1}`,
+      kind: "model",
+      model,
+      weight: 0,
+    })),
+    // The list IS the fallback order: hop to the next model at once. (OmniRoute already rotates
+    // accounts inside one attempt; the default same-model retry would add a 2 s stall per dead member.)
+    config: { maxRetries: 0 },
+    // lets chat.ts read this invocation's per-attempt outcomes back for onRouteResult
+    traceInvocationId: createInvocationId(),
+    // Route provenance for the response head; never persisted with the combo.
+    routeReason: typeof metadata.reason === "string" ? metadata.reason : undefined,
+    routeConfidence: typeof metadata.confidence === "number" ? metadata.confidence : undefined,
+    routeThinking: normalizePluginThinking(metadata.thinking) ?? undefined,
+    routeThinkingByModel: normalizeThinkingByModel(metadata.thinkingByModel, models) ?? undefined,
+    routeItem: normalizeRouteItem(metadata.item) ?? undefined,
+    routeSpecialist: typeof metadata.specialist === "boolean" ? metadata.specialist : undefined,
+    routeWindowsByModel: normalizeWindowsByModel(metadata.windowsByModel, models) ?? undefined,
+    isHidden: true,
+    isActive: true,
+    sortOrder: 0,
+    version: 1,
+  };
+}
+
+/**
+ * Write the plugin's native thinking control into the request body. Mutates a copy, never the
+ * caller's object: the combo path may reuse the body for other targets. Conflicting effort
+ * fields are removed so one control wins; the plugin only sends a value the route is known to
+ * accept (its per-model map), so this is not a guess about the provider's enum.
+ */
+export function applyPluginRouteThinking<T>(body: T, thinking: unknown): T {
+  const t = normalizePluginThinking(thinking);
+  if (!body || typeof body !== "object" || Array.isArray(body) || !t) return body;
+  const next = { ...(body as Record<string, unknown>) };
+  const reasoning =
+    next.reasoning && typeof next.reasoning === "object" && !Array.isArray(next.reasoning)
+      ? { ...(next.reasoning as Record<string, unknown>) }
+      : null;
+  delete reasoning?.effort;
+  if (reasoning && Object.keys(reasoning).length === 0) delete next.reasoning;
+  else if (reasoning) next.reasoning = reasoning;
+  if (
+    next.output_config &&
+    typeof next.output_config === "object" &&
+    !Array.isArray(next.output_config)
+  ) {
+    const output = { ...(next.output_config as Record<string, unknown>) };
+    delete output.effort;
+    if (Object.keys(output).length === 0) delete next.output_config;
+    else next.output_config = output;
+  }
+
+  if (t.control === "none") {
+    delete next.reasoning_effort;
+    delete next.thinking;
+    return next as T;
+  }
+  if (t.control === "effort") {
+    next.reasoning_effort = String(t.value);
+    delete next.thinking;
+    return next as T;
+  }
+  delete next.reasoning_effort;
+  next.thinking = { type: t.value === "off" ? "disabled" : "enabled" };
+  return next as T;
+}
+
+/** Allowlist `jev`, `static`, `static:cont`; anything else is omitted (never echoed). */
+function normalizeRouteReason(value: unknown): string | null {
+  if (typeof value !== "string") return null;
+  const reason = value.trim();
+  return reason === "jev" || reason === "static" || reason === "static:cont" ? reason : null;
+}
+
+/** 0..1 only; rounded to three decimals to keep the header stable (warslop parses basis points). */
+function normalizeRouteConfidence(value: unknown): string | null {
+  if (typeof value !== "number" || !Number.isFinite(value) || value < 0 || value > 1) return null;
+  return String(Math.round(value * 1000) / 1000);
+}
+
+function safeHeaderValue(value: unknown): string | null {
+  if (typeof value !== "string") return null;
+  const trimmed = value.trim();
+  if (!trimmed || trimmed.length > 512 || /[\r\n]/.test(trimmed)) return null;
+  return trimmed;
+}
+
+/**
+ * Route provenance for a successful plugin-routed combo: the exact dispatched target, how many
+ * attempts ran, and the plugin's reason/confidence. Only routing metadata — never a body or key.
+ * The header map is empty until the combo has a successful outcome, so failed requests keep their
+ * existing headers.
+ */
+export function buildPluginRouteHeaders(
+  combo: PluginRouteComboLike | null | undefined,
+  trace?: ComboTrace | null
+): Record<string, string> {
+  if (!combo) return {};
+  const invocation =
+    trace ?? (combo.traceInvocationId ? getComboTrace(combo.traceInvocationId) : null);
+  const outcomes = invocation?.outcomes ?? [];
+  const success = [...outcomes].reverse().find((o) => o.ok);
+  const target = safeHeaderValue(success?.target);
+  if (!target) return {};
+
+  const headers: Record<string, string> = {
+    "x-omniroute-route": target,
+    "x-omniroute-attempts": String(outcomes.length),
+  };
+  const reason = normalizeRouteReason(combo.routeReason);
+  if (reason) {
+    headers["x-router-reason"] = reason;
+    // Confidence is meaningful only when Jev's pick was the one applied.
+    const confidence = reason === "jev" ? normalizeRouteConfidence(combo.routeConfidence) : null;
+    if (confidence) headers["x-router-confidence"] = confidence;
+  }
+  // Patch 0010: the plugin's menu item, and the thinking the ANSWERING attempt carried ("default" = no field).
+  const item = normalizeRouteItem(combo.routeItem);
+  if (item) headers["x-router-item"] = item;
+  if (item && typeof combo.routeSpecialist === "boolean")
+    headers["x-router-specialist"] = combo.routeSpecialist ? "yes" : "no";
+  if (combo.routeThinkingByModel || combo.routeThinking) {
+    const t = pluginAttemptThinking(combo, target);
+    headers["x-router-thinking"] = t && t.control !== "none" && t.value ? t.value : "default";
+  }
+  // Patch 0011: the answering route's own figures. Absent when the plugin knew neither for it.
+  const win = combo.routeWindowsByModel?.[target];
+  if (win?.context_length) headers["x-omniroute-context-length"] = String(win.context_length);
+  if (win?.max_output_tokens)
+    headers["x-omniroute-max-output-tokens"] = String(win.max_output_tokens);
+  return headers;
+}
+
+/** Add the route headers to a Response before its head is committed. Never throws. */
+export function withPluginRouteHeaders<T extends Response | null | undefined>(
+  response: T,
+  combo: PluginRouteComboLike | null | undefined
+): T | Response {
+  if (!response) return response;
+  try {
+    const headers = buildPluginRouteHeaders(combo);
+    if (Object.keys(headers).length === 0) return response;
+    try {
+      for (const [name, value] of Object.entries(headers)) response.headers.set(name, value);
+      return response;
+    } catch {
+      const cloned = new Response(response.body, {
+        status: response.status,
+        statusText: response.statusText,
+        headers: response.headers,
+      });
+      for (const [name, value] of Object.entries(headers)) cloned.headers.set(name, value);
+      return cloned;
+    }
+  } catch {
+    return response;
+  }
+}
+
+/**
+ * onRouteResult: after the plugin-routed combo finished, tell the plugin how each dispatched target
+ * went (HTTP status + allowlisted kind, never an error body) and which targets OmniRoute skipped.
+ * Fire-and-forget: never awaited by the request, never throws.
+ */
+export function emitPluginRouteResult(args: {
+  requestId: string;
+  requestedModel: string;
+  combo: PluginRouteComboLike;
+  response: { status: number };
+  log?: LoggerLike;
+}): void {
+  void (async () => {
+    try {
+      const id = args.combo.traceInvocationId;
+      const trace = id ? getComboTrace(id) : null;
+      if (!trace) return;
+      const { runOnRouteResult } = await import("@/lib/plugins/hooks");
+      await runOnRouteResult({
+        requestId: args.requestId,
+        model: args.requestedModel,
+        status: args.response.status,
+        listed: args.combo.models.map((m) => m.model),
+        attempts: trace.outcomes.map((o) => ({
+          model: o.target,
+          ok: o.ok,
+          status: o.status,
+          kind: o.kind,
+          latencyMs: o.latencyMs,
+          ...(o.limit ? { limit: true } : {}),
+        })),
+        skipped: trace.decisions
+          .filter((d) => d.decision === "skipped_before_dispatch")
+          .map((d) => ({ model: d.target, reason: d.reason ?? "unknown" })),
+      });
+    } catch (err) {
+      args.log?.debug?.(
+        "PLUGIN",
+        `onRouteResult error (non-fatal): ${err instanceof Error ? err.message : String(err)}`
+      );
+    }
+  })();
+}
