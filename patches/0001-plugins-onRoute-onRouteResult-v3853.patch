+
+test("0011: the provenance frame carries only the allowlisted routing headers, windows included", () => {
+  const frame = openAiRouteProvenanceFrame(
+    new Headers({
+      "x-omniroute-route": "ocpaid/opencode-go/deepseek-v4.1-flash",
+      "x-omniroute-attempts": "1",
+      "x-omniroute-context-length": "1048576",
