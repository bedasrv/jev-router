+      "b/y": { context_length: 1048576, max_output_tokens: 131072 },
+    },
+  });
+  traced(String(combo.traceInvocationId), [
+    { target: "a/x", ok: false, status: 502 },
+    { target: "b/y", ok: true, status: 200 },
+  ]);
+  assert.deepEqual(buildPluginRouteHeaders(combo), {
+    "x-omniroute-route": "b/y",
+    "x-omniroute-attempts": "2",
+    "x-router-reason": "jev",
+    "x-router-confidence": "0.9",
+    "x-omniroute-context-length": "1048576",
+    "x-omniroute-max-output-tokens": "131072",
+  });
+});
+
+test("0011: only usable figures for the answering attempt are echoed (a partial window keeps its good half)", () => {
+  resetComboTraceStore();
+  const combo = buildPluginRouteCombo("paid", ["a/x"], "r41", {
+    windowsByModel: {
+      "a/x": { context_length: 400000, max_output_tokens: 16384.5 },
+    },
+  });
