+// ─── #16575: DOM response reader (StreamGenerate URL match is dead) ──────────
+//
+// Gemini's current web build (Argon era, boq-gemini-web-uiserver_20261015.13_p0)
+// renders the answer in the DOM while the bytes travel over opaque
+// batchexecute/RPC channels that carry no "StreamGenerate" in the URL and no
+// plaintext wrb.fr frames in the body. The executor must therefore read the
+// rendered answer instead of sniffing network responses — these tests pin the
+// reader's polling contract so the failure mode (30s wait → 502 "No response
+// from Gemini") cannot silently return.
+
+const {
+  readGeminiResponseFromDom,
+  collectGeminiDomState,
+  clickGeminiSendButtonInPage,
+} = await import("../../open-sse/executors/gemini-web.ts");
+
+interface FakeState {
+  responses: string[];
+  processing: boolean;
+  stopVisible: boolean;
+}
+
+/** Fake Playwright page: replays a scripted sequence of DOM states, one per poll. */
+function fakePage(states: Partial<FakeState>[]) {
+  const calls: Array<unknown[]> = [];
+  let i = 0;
+  return {
+    page: {
+      evaluate: async (...args: unknown[]) => {
+        calls.push(args);
+        const argCount = args.length; // Playwright allows exactly ONE evaluate argument
+        const opts = args[1] as { selector?: string } | undefined;
+        if (argCount !== 2 || !opts || typeof opts.selector !== "string") {
+          throw new Error(
+            "Too many arguments. If you need to pass more than 1 argument to the function wrap them in an object."
+          );
+        }
+        const scripted = states[Math.min(i, states.length - 1)];
+        i += 1;
+        return {
+          responses: scripted.responses ?? [],
+          processing: scripted.processing ?? false,
+          stopVisible: scripted.stopVisible ?? false,
+          pending: scripted.pending ?? false,
+        };
+      },
+      waitForTimeout: async () => {},
+    },
+    pollCount: () => calls.length,
+  };
+}
+
+test("#16575: returns the answer once generation finished and text is stable", async () => {
+  const { page, pollCount } = fakePage([
+    { responses: [""], processing: true, stopVisible: true },
+    { responses: ["Hello"], processing: true, stopVisible: true },
+    { responses: ["Hello!"], processing: false, stopVisible: false },
+    { responses: ["Hello!"], processing: false, stopVisible: false },
+  ]);
+  const text = await readGeminiResponseFromDom(page, { pollMs: 1, stablePolls: 2 });
+  assert.equal(text, "Hello!");
+  assert.ok(pollCount() >= 3, "must not answer before two settled polls");
+});
