+// ─── DOM response reader (#16575) ───────────────────────────────────────────
+//
+// Since the Argon-era frontend build, Gemini's web UI renders the answer in the
+// DOM while the actual bytes travel over channels this executor can no longer
+// identify by URL (see the module header). Reading the rendered answer is
+// transport-agnostic: it survives rpcid renames, response encryption, and
+// whatever the frontend migrates to next.
+//
+// Completion detection combines two live signals plus text stability:
+//   1. the last `model-response-text` block lost its `processing-state-visible`
+//      state (Gemini's own "still generating" marker),
+//   2. the "Stop response" button is no longer visible,
+//   3. the block's text stopped changing across two consecutive polls.
+
+/** Custom element wrapping one rendered assistant answer. */
+export const GEMINI_RESPONSE_SELECTOR = "model-response-text";
+/** Class Gemini puts on that block while the answer is still streaming. */
+export const GEMINI_PROCESSING_CLASS = "processing-state-visible";
+/** aria-label substring of the button rendered only while generating. */
+export const GEMINI_STOP_LABEL_NEEDLE = "stop response";
+
+const GEMINI_DOM_POLL_MS = 750;
+const GEMINI_DOM_STABLE_POLLS = 2;
+/** Generous cap: normal answers settle in seconds; a hung generation must not hang forever. */
+const GEMINI_DOM_MAX_WAIT_MS = 120_000;
+
+export interface GeminiDomState {
+  /** innerText of every answer block, in DOM order. */
+  responses: string[];
+  /** true while any answer block is still marked as processing. */
+  processing: boolean;
+  /** true while the Stop-response button is rendered and visible. */
+  stopVisible: boolean;
+  /** true while the thinking-dots/pending-response placeholders are still on screen. */
+  pending: boolean;
+}
+
+/**
+ * Runs inside the browser page. Kept dependency-free (no closures) so it can be
+ * serialized through `page.evaluate` and stubbed in unit tests. Playwright's
+ * evaluate() passes at most one argument, hence the single options object.
+ */
+export function collectGeminiDomState(
+  opts: { selector: string; processingClass: string; stopLabelNeedle: string },
+  doc: Document = (globalThis as { document?: Document }).document as Document
+): GeminiDomState {
+  const blocks = Array.from(doc.querySelectorAll(opts.selector)) as HTMLElement[];
+  const responses = blocks.map((b) => (b.innerText || "").trim());
+  const processing = blocks.some((b) => b.classList.contains(opts.processingClass));
+  let stopVisible = false;
+  for (const button of Array.from(doc.querySelectorAll("button"))) {
+    const label = (button.getAttribute("aria-label") || "").toLowerCase();
+    if (label.includes(opts.stopLabelNeedle)) {
+      stopVisible = !!(button as HTMLElement).offsetParent;
+      break;
+    }
+  }
+  // Gemini renders thinking-dots-animation / pending-response while the answer
+  // is still being generated; both disappear once the answer is in the DOM.
+  const pending = [".thinking-dots-animation", "pending-response"].some((sel) =>
+    Array.from(doc.querySelectorAll(sel)).some((el) => !!(el as HTMLElement).offsetParent)
+  );
+  return { responses, processing, stopVisible, pending };
+}
+
+/** Minimal surface of a Playwright page this reader needs — kept structural so tests can stub it. */
+export interface GeminiDomPage {
+  evaluate: (fn: (...args: never[]) => unknown, ...args: unknown[]) => Promise<unknown>;
+}
+
+/** aria-label of the composer's submit button in the current Gemini web UI. */
+export const GEMINI_SEND_BUTTON_LABEL = "send message";
+
+/**
+ * In-page half of clickGeminiSendButton (see there). Kept as a plain function
+ * with an injectable document so unit tests can drive it without a browser.
+ */
+export function clickGeminiSendButtonInPage(
+  needle: string,
+  doc: Document = (globalThis as { document?: Document }).document as Document
+): boolean {
+  const buttons = Array.from(doc.querySelectorAll("button"));
+  const send = buttons.find((b) =>
+    (b.getAttribute("aria-label") || "").toLowerCase().includes(needle)
+  );
+  if (!send) return false;
+  (send as HTMLElement).click();
+  return true;
+}
+
+/**
+ * Submit the typed prompt via the composer's send button.
+ *
+ * #16575 follow-up (2026-10-16): the Enter key stopped submitting in the current
+ * Gemini web build under automation — the optimistic user bubble renders, the
+ * Stop button flashes, but no generation ever starts and no answer block appears.
+ * Clicking the send button (aria-label "Send message") submits reliably. Returns
+ * false when no send button is present so the caller can fall back to Enter.
+ */
+export async function clickGeminiSendButton(page: {
+  evaluate: (fn: (...args: never[]) => unknown, ...args: never[]) => Promise<unknown>;
+}): Promise<boolean> {
+  return (await page.evaluate(
+    clickGeminiSendButtonInPage as unknown as (...args: never[]) => unknown,
+    GEMINI_SEND_BUTTON_LABEL
+  )) as boolean;
+}
+
+export interface GeminiDomReaderOptions {
+  pollMs?: number;
+  stablePolls?: number;
+  maxWaitMs?: number;
+  /** Checked every poll; when it fires the reader stops waiting and returns what it has. */
+  isAborted?: () => boolean;
+}
+
+/** Macrotask sleep — a microtask-only await chain would starve abort/event timers. */
+function sleep(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+/**
+ * Wait for Gemini's answer to render and settle, returning its text.
+ * Returns the last (partial) answer text if the wait budget expires mid-generation,
+ * or "" when no answer block ever appeared (executor maps that to its 502 contract).
+ */
+export async function readGeminiResponseFromDom(
+  page: GeminiDomPage,
+  opts: GeminiDomReaderOptions = {}
+): Promise<string> {
+  const pollMs = opts.pollMs ?? GEMINI_DOM_POLL_MS;
+  const stablePolls = opts.stablePolls ?? GEMINI_DOM_STABLE_POLLS;
+  const maxWaitMs = opts.maxWaitMs ?? GEMINI_DOM_MAX_WAIT_MS;
+  const deadline = Date.now() + maxWaitMs;
+
+  let stable = 0;
+  let lastText = "";
+
+  while (Date.now() < deadline) {
+    if (opts.isAborted?.()) break;
+    const state = (await page.evaluate(
+      collectGeminiDomState as unknown as (...args: never[]) => unknown,
+      {
+        selector: GEMINI_RESPONSE_SELECTOR,
+        processingClass: GEMINI_PROCESSING_CLASS,
+        stopLabelNeedle: GEMINI_STOP_LABEL_NEEDLE,
+      }
+    )) as GeminiDomState;
+    const current = state.responses[state.responses.length - 1] ?? "";
+
+    if (current && !state.processing && !state.stopVisible && !state.pending) {
+      stable += 1;
+      if (stable >= stablePolls) return current;
+    } else {
+      stable = 0;
+    }
+    lastText = current;
+    await sleep(pollMs);
+  }
+  return lastText.trim();
+}
