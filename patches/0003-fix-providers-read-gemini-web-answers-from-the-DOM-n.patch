+test("#16575: falls back to the partial answer when the wait budget expires mid-generation", async () => {
+  const { page } = fakePage([{ responses: ["partial ans"], processing: true, stopVisible: true }]);
+  const text = await readGeminiResponseFromDom(page, { pollMs: 1, maxWaitMs: 10 });
+  assert.equal(text, "partial ans");
+});
+
+test("#16575: collectGeminiDomState extracts blocks, processing state and stop-button visibility", () => {
+  const makeBlock = (innerText: string, processing: boolean) => {
+    const el = {
+      innerText,
+      classList: { contains: (c: string) => processing && c === "processing-state-visible" },
+    };
+    return el as never;
+  };
+  const stopButton = {
+    getAttribute: (a: string) => (a === "aria-label" ? "Stop response" : null),
+    offsetParent: {},
+  } as never;
+  const dots = { offsetParent: {} } as never;
+  const doc = {
+    querySelectorAll: (sel: string) => {
+      if (sel === "model-response-text") return [makeBlock("first", false), makeBlock("second", true)];
+      if (sel === "button") return [stopButton];
+      if (sel === ".thinking-dots-animation") return [dots];
+      return [];
+    },
+  } as never;
+  const state = collectGeminiDomState(
+    { selector: "model-response-text", processingClass: "processing-state-visible", stopLabelNeedle: "stop response" },
+    doc
+  );
+  assert.deepEqual(state.responses, ["first", "second"]);
+  assert.equal(state.processing, true);
+  assert.equal(state.stopVisible, true);
+  assert.equal(state.pending, true);
+});
+
+test("#16575: stops polling once the caller's abort signal fires", async () => {
+  const controller = new AbortController();
+  const { page } = fakePage([
+    { responses: ["half ans"], processing: true, stopVisible: true },
+  ]);
+  const promise = readGeminiResponseFromDom(page, {
+    pollMs: 1,
+    maxWaitMs: 5000,
+    isAborted: () => controller.signal.aborted,
+  });
+  controller.abort();
+  const text = await promise;
+  assert.equal(text, "half ans", "returns the partial text, does not keep polling");
+});
+
+test("#16575: clickGeminiSendButtonInPage clicks the labeled send button", () => {
+  let clicked = false;
+  const doc = {
+    querySelectorAll: (sel: string) =>
+      sel === "button"
+        ? [
+            {
+              getAttribute: (a: string) => (a === "aria-label" ? "Send message" : null),
+              click: () => {
+                clicked = true;
+              },
+            },
+          ]
+        : [],
+  } as never;
+  const clickedIt = clickGeminiSendButtonInPage("send message", doc);
+  assert.equal(clickedIt, true);
+  assert.equal(clicked, true);
+});
+
+test("#16575: clickGeminiSendButtonInPage returns false when no send button exists (Enter fallback)", () => {
+  const doc = {
+    querySelectorAll: (sel: string) =>
+      sel === "button" ? [{ getAttribute: () => null, click: () => {} }] : [],
+  } as never;
+  assert.equal(clickGeminiSendButtonInPage("send message", doc), false);
+});
+
+test("#16575: clickGeminiSendButton routes the in-page click through page.evaluate with one argument", async () => {
+  const { clickGeminiSendButton } = await import("../../open-sse/executors/gemini-web.ts");
+  const seen: { args: unknown[]; arg: unknown } = { args: [], arg: undefined };
+  const page = {
+    evaluate: async (...args: unknown[]) => {
+      seen.args = args;
+      seen.arg = args[1];
+      return true;
+    },
+  };
+  const ok = await clickGeminiSendButton(page);
+  assert.equal(ok, true);
+  assert.equal(seen.args.length, 2, "page.evaluate takes exactly one argument");
+  assert.equal(seen.arg, "send message");
+});
