 src/sse/handlers/chat.ts               |  6 +++
 src/sse/handlers/chat/pluginOnRoute.ts | 58 ++++++++++++++++++++++++++
 tests/unit/plugins-onroute.test.ts     | 49 +++++++++++++++++++++-
 4 files changed, 125 insertions(+), 1 deletion(-)

