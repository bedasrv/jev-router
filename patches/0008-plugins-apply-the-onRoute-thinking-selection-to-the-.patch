 };
 
 export const MAX_PLUGIN_ROUTE_MODELS = 12;
 
+/** Allowlist the wire shape; anything malformed is dropped rather than sent upstream. */
+function normalizePluginThinking(value: unknown): PluginThinking | null {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return null;
+  const record = value as Record<string, unknown>;
+  const control = record.control;
+  if (control === "none") return { control };
+  if (control !== "effort" && control !== "toggle") return null;
+  const text = typeof record.value === "string" ? record.value.trim() : "";
+  if (!text || text.length > 32 || /[\r\n]/.test(text)) return null;
+  if (control === "toggle" && text !== "off" && text !== "on") return null;
+  return { control, value: text };
+}
+
 export async function runPluginOnRouteHook(args: {
   requestId: string;
   body: unknown;
@@ -81,10 +98,12 @@ export async function runPluginOnRouteHook(args: {
       "PLUGIN",
       `onRoute: ${args.model} → [${models.join(", ")}]${result.reason ? ` (${result.reason})` : ""}`
     );
+    const thinking = normalizePluginThinking(result.thinking);
     return {
       models,
       ...(typeof result.reason === "string" ? { reason: result.reason } : {}),
       ...(typeof result.confidence === "number" ? { confidence: result.confidence } : {}),
+      ...(thinking ? { thinking } : {}),
     };
   } catch (err) {
     args.log?.debug?.(
@@ -120,6 +139,7 @@ export function buildPluginRouteCombo(
     // Route provenance for the response head; never persisted with the combo.
     routeReason: typeof metadata.reason === "string" ? metadata.reason : undefined,
     routeConfidence: typeof metadata.confidence === "number" ? metadata.confidence : undefined,
+    routeThinking: normalizePluginThinking(metadata.thinking) ?? undefined,
     isHidden: true,
     isActive: true,
     sortOrder: 0,
@@ -127,6 +147,44 @@ export function buildPluginRouteCombo(
   };
 }
 
+/**
+ * Write the plugin's native thinking control into the request body. Mutates a copy, never the
+ * caller's object: the combo path may reuse the body for other targets. Conflicting effort
+ * fields are removed so one control wins; the plugin only sends a value the route is known to
+ * accept (its per-model map), so this is not a guess about the provider's enum.
+ */
+export function applyPluginRouteThinking<T>(body: T, thinking: unknown): T {
+  const t = normalizePluginThinking(thinking);
+  if (!body || typeof body !== "object" || Array.isArray(body) || !t) return body;
+  const next = { ...(body as Record<string, unknown>) };
+  const reasoning = next.reasoning && typeof next.reasoning === "object" && !Array.isArray(next.reasoning)
+    ? { ...(next.reasoning as Record<string, unknown>) }
+    : null;
+  delete reasoning?.effort;
+  if (reasoning && Object.keys(reasoning).length === 0) delete next.reasoning;
+  else if (reasoning) next.reasoning = reasoning;
+  if (next.output_config && typeof next.output_config === "object" && !Array.isArray(next.output_config)) {
+    const output = { ...(next.output_config as Record<string, unknown>) };
+    delete output.effort;
+    if (Object.keys(output).length === 0) delete next.output_config;
+    else next.output_config = output;
+  }
+
+  if (t.control === "none") {
+    delete next.reasoning_effort;
+    delete next.thinking;
+    return next as T;
+  }
+  if (t.control === "effort") {
+    next.reasoning_effort = String(t.value);
+    delete next.thinking;
+    return next as T;
+  }
+  delete next.reasoning_effort;
+  next.thinking = { type: t.value === "off" ? "disabled" : "enabled" };
+  return next as T;
+}
+
 /** Allowlist `jev`, `static`, `static:cont`; anything else is omitted (never echoed). */
 function normalizeRouteReason(value: unknown): string | null {
   if (typeof value !== "string") return null;
