+test("applyPluginRouteThinking writes effort and toggle without mutating input or max_tokens", () => {
+  const body: Record<string, any> = { model: "paid", max_tokens: 4096, messages: [], reasoning: { effort: "high", summary: "auto" }, output_config: { effort: "high" } };
+  assert.equal(applyPluginRouteThinking<Record<string, any>>({ model: "x" }, { control: "effort", value: "medium" }).reasoning_effort, "medium");
+  const effort = applyPluginRouteThinking(body, { control: "effort", value: "low" });
+  assert.equal(effort.reasoning_effort, "low");
+  assert.equal(effort.max_tokens, 4096); // output is never capped
+  assert.deepEqual(effort.reasoning, { summary: "auto" });
+  assert.equal(effort.output_config, undefined);
+  assert.equal(body.reasoning_effort, undefined); // copy only
+  assert.deepEqual(body.reasoning, { effort: "high", summary: "auto" });
+
+  const off = applyPluginRouteThinking<Record<string, any>>({ model: "x", max_tokens: 100, reasoning_effort: "high" }, { control: "toggle", value: "off" });
+  assert.deepEqual(off, { model: "x", max_tokens: 100, thinking: { type: "disabled" } });
+  const on = applyPluginRouteThinking<Record<string, any>>({ model: "x" }, { control: "toggle", value: "on" });
+  assert.deepEqual(on.thinking, { type: "enabled" });
+});
+
+test("applyPluginRouteThinking none clears a client-sent effort and never touches max_tokens", () => {
+  const body: Record<string, any> = {
+    model: "x", max_tokens: 123,
+    reasoning_effort: "high", reasoning: { effort: "high", summary: "auto" },
+    output_config: { effort: "high", format: "json" }, thinking: { type: "enabled" },
+  };
+  const out = applyPluginRouteThinking(body, { control: "none" });
+  assert.equal(out.reasoning_effort, undefined);
+  assert.deepEqual(out.reasoning, { summary: "auto" });
+  assert.deepEqual(out.output_config, { format: "json" });
+  assert.equal(out.thinking, undefined);
+  assert.equal(out.max_tokens, 123);
+  assert.equal(body.reasoning_effort, "high"); // copy only
+});
+
+test("applyPluginRouteThinking ignores malformed or budget-only controls", () => {
+  const body = { model: "x", reasoning_effort: "high" };
+  assert.equal(applyPluginRouteThinking(body, null), body);
+  assert.equal(applyPluginRouteThinking(body, { control: "max", value: "high" }), body);
+  assert.equal(applyPluginRouteThinking(body, { control: "toggle", value: "maybe" }), body);
+  assert.equal(applyPluginRouteThinking(body, { control: "budget", value: 4096 }), body); // omitted in v1
+});
+
+test("buildPluginRouteCombo carries the thinking control", () => {
+  const c = buildPluginRouteCombo("paid", ["a/x"], "r13", { thinking: { control: "effort", value: "medium" } });
+  assert.deepEqual(c.routeThinking, { control: "effort", value: "medium" });
+});
