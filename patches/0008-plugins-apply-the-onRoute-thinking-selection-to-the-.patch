+/**
+ * One native thinking control the plugin wants applied to this request. The plugin maps its
+ * abstract off|low|medium|high choice to the chosen model's vocabulary; OmniRoute only writes
+ * the corresponding request field.
+ */
+export interface PluginThinkingSelection {
+  control: "effort" | "toggle" | "none";
+  /** effort: a level such as none/low/medium/high; toggle: off/on; none: omitted/empty. */
+  value?: string;
+}
+
