+/**
+ * Patch 0010: a provider's spent allowance for this model (a per-model usage limit, a quota), as opposed to a short
+ * rate limit. OpenCode Go limits each model by dollars per 5 hours, week and month; its free tier says "Free usage
+ * limit reached". Only the boolean leaves the host (the error text never reaches a plugin).
+ */
+const USAGE_LIMIT_TEXT = /usage.?limit|limit (has been )?reached|quota|allowance|exceeded your|insufficient (balance|credit|quota)|subscribe to opencode go/i;
+export function isUsageLimitError(status: number | null | undefined, errorText: unknown): boolean {
+  if (status !== 429 && status !== 402 && status !== 403) return false;
+  return typeof errorText === "string" && USAGE_LIMIT_TEXT.test(errorText);
+}
