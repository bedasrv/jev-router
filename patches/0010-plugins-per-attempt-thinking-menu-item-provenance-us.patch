+const ITEM_ID = /^[A-Za-z0-9_-]{1,16}$/;
+
+/** A menu item id, or null: never echoed unless it is a short plain token. */
+function normalizeRouteItem(value: unknown): string | null {
+  return typeof value === "string" && ITEM_ID.test(value) ? value : null;
+}
+
+/**
+ * Per-attempt thinking: only targets that are in the final model list, each through the same allowlist
+ * as `thinking`. A malformed entry is dropped (that attempt then gets {control:"none"}). Null when the
+ * plugin sent no usable map, so the single-`thinking` behaviour of 0008 stays.
+ */
+function normalizeThinkingByModel(value: unknown, models: string[]): Record<string, PluginThinking> | null {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return null;
+  const out: Record<string, PluginThinking> = {};
+  for (const model of models) {
+    if (!Object.prototype.hasOwnProperty.call(value, model)) continue;
+    const t = normalizePluginThinking((value as Record<string, unknown>)[model]);
+    if (t) out[model] = t;
+  }
+  return Object.keys(out).length ? out : null;
+}
+
+/**
+ * The thinking one attempt of a plugin-routed combo carries: its own entry when the plugin sent a
+ * per-attempt map, {control:"none"} for a target the map leaves out, or the shared selection (0008).
+ */
+export function pluginAttemptThinking(
+  combo: PluginRouteComboLike | null | undefined,
+  model: string
+): PluginThinking | undefined {
+  if (!combo) return undefined;
+  if (combo.routeThinkingByModel) return combo.routeThinkingByModel[model] ?? { control: "none" };
+  return combo.routeThinking;
+}
